# Copy this file to .env and change both password values before running setup.
# Use long unique passwords. For fewer connection-string surprises, use letters and numbers.
POSTGRES_DB=auditflow
POSTGRES_USER=auditflow
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_DATABASE_PASSWORD
AUDITFLOW_BOOTSTRAP_ADMIN_USER=auditadmin
AUDITFLOW_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_ADMIN_PASSWORD
AUDITFLOW_BOOTSTRAP_ADMIN_EMAIL=
AUDITFLOW_HTTP_PORT=8000
