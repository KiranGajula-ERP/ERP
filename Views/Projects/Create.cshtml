@model CreateProjectViewModel
@{ ViewData["Title"] = "Create project"; }
<div class="section-head"><div><h1>Create project</h1><p class="subheading">A project store and tower records will be created automatically.</p></div><a asp-action="Index" class="button button-light">Cancel</a></div>
<div class="card"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label asp-for="Code">Project code *</label><input asp-for="Code"/><span asp-validation-for="Code" class="validation-message"></span></div><div class="field"><label asp-for="Name">Project name *</label><input asp-for="Name"/><span asp-validation-for="Name" class="validation-message"></span></div><div class="field"><label asp-for="ClientName">Client</label><input asp-for="ClientName"/></div><div class="field"><label asp-for="ContractValue">Contract value (₹)</label><input asp-for="ContractValue" type="number" min="0" step="0.01"/></div><div class="field"><label asp-for="StartDate">Start date</label><input asp-for="StartDate" type="date"/></div><div class="field"><label asp-for="PlannedEndDate">Planned completion</label><input asp-for="PlannedEndDate" type="date"/></div><div class="field wide"><label asp-for="SiteAddress">Site address</label><textarea asp-for="SiteAddress"></textarea></div><div class="field wide"><label>Towers / blocks (one per line)</label><textarea asp-for="TowerNamesText" placeholder="Tower A&#10;Tower B&#10;Tower C"></textarea><span class="muted small">Leave blank to create a General Site tower.</span></div></div><div class="form-actions"><button class="button button-primary" type="submit">Create project</button></div></form></div>
