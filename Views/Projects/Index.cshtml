@model List<Project>
@{ ViewData["Title"] = "Projects"; }
<div class="section-head"><div><h1>Projects</h1><p class="subheading">Only projects assigned to your active role are shown.</p></div>@if(User.IsInRole(AppRoles.SystemAdministrator)||User.IsInRole(AppRoles.Management)){<a asp-action="Create" class="button button-primary">+ Create project</a>}</div>
<div class="card"><div class="table-wrap"><table><thead><tr><th>Project</th><th>Client</th><th>Contract value</th><th>Period</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td><strong>@p.Name</strong><div class="muted small">@p.Code</div></td><td>@p.ClientName</td><td class="number">₹@p.ContractValue.ToString("N2")</td><td>@p.StartDate?.ToString("dd-MMM-yyyy") – @p.PlannedEndDate?.ToString("dd-MMM-yyyy")</td><td><span class="tag tag-green">@p.Status</span></td><td><a class="button button-light button-sm" asp-action="Details" asp-route-id="@p.Id">Open project</a></td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="empty-state"><strong>No projects assigned</strong>Ask your System Administrator to create a project and assign your account.</div>}</div>
