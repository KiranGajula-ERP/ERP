@model Project
@{ ViewData["Title"] = "Project details"; var store = ViewBag.Store as StoreLocation; }
<div class="section-head"><div><h1>@Model.Name</h1><p class="subheading">@Model.Code · @Model.ClientName</p></div><div class="btn-row"><a class="button button-light" asp-controller="Projects" asp-action="Index">All projects</a><a class="button button-light" asp-controller="Inventory" asp-action="Index" asp-route-projectId="@Model.Id">Project inventory</a><a class="button button-light" asp-controller="WorkOrders" asp-action="Index" asp-route-projectId="@Model.Id">Work Orders / BOQ</a><a class="button button-primary" asp-controller="Expenses" asp-action="Index" asp-route-projectId="@Model.Id">Project expenses</a></div></div>
<div class="tiles"><div class="tile saffron"><span class="label">Contract Value</span><span class="value">₹@Model.ContractValue.ToString("N2")</span></div><div class="tile blue"><span class="label">Raised Indents</span><span class="value">@ViewBag.IndentCount</span><a class="hint" asp-controller="Indents" asp-action="Index" asp-route-projectId="@Model.Id">View Indents →</a></div><div class="tile"><span class="label">Tasks</span><span class="value">@ViewBag.TaskCount</span><a class="hint" asp-controller="Tasks" asp-action="Index" asp-route-projectId="@Model.Id">View tasks →</a></div><div class="tile green"><span class="label">Client RA Bills</span><span class="value">@ViewBag.BillCount</span><a class="hint" asp-controller="Billing" asp-action="Index" asp-route-projectId="@Model.Id">View billing →</a></div></div>
<div class="section-head" style="margin-top:24px"><div><h2>Project Workspace</h2><p class="subheading">Project-level cumulative commercial, inventory and execution values.</p></div></div>
<div class="tiles"><div class="tile"><span class="label">MR / BOQ Value</span><span class="value">₹@(((decimal)ViewBag.MRValue).ToString("N2"))</span></div><div class="tile blue"><span class="label">Purchase Orders · Count</span><span class="value">@ViewBag.POCount</span></div><div class="tile blue"><span class="label">Purchase Orders · Value</span><span class="value">₹@(((decimal)ViewBag.POValue).ToString("N2"))</span></div><div class="tile"><span class="label">Material Invoices · Count</span><span class="value">@ViewBag.InvoiceCount</span></div><div class="tile"><span class="label">Material Invoices · Value</span><span class="value">₹@(((decimal)ViewBag.InvoiceValue).ToString("N2"))</span></div><a class="tile saffron" asp-controller="Billing" asp-action="Index" asp-route-projectId="@Model.Id"><span class="label">Revenue Billed</span><span class="value">₹@(((decimal)ViewBag.RevenueBilled).ToString("N2"))</span><span class="hint">Client Billing Register →</span></a><div class="tile green"><span class="label">Revenue Collected</span><span class="value">₹@(((decimal)ViewBag.RevenueCollected).ToString("N2"))</span></div><a class="tile" asp-controller="Inventory" asp-action="Matrix" asp-route-kind="issued" asp-route-projectId="@Model.Id"><span class="label">Material Used Value</span><span class="value">₹@(((decimal)ViewBag.MaterialUsedValue).ToString("N2"))</span><span class="hint">Issued stock cost →</span></a><a class="tile red" asp-controller="Inventory" asp-action="Matrix" asp-route-kind="wastage" asp-route-projectId="@Model.Id"><span class="label">Wastage</span><span class="value">₹@(((decimal)ViewBag.WastageValue).ToString("N2"))</span><span class="hint">Wastage register →</span></a><a class="tile" asp-controller="Expenses" asp-action="Index" asp-route-projectId="@Model.Id"><span class="label">Overheads</span><span class="value">₹@(((decimal)ViewBag.OverheadValue).ToString("N2"))</span><span class="hint">Expenses →</span></a><div class="tile"><span class="label">Transportation</span><span class="value">₹@(((decimal)ViewBag.TransportValue).ToString("N2"))</span></div><div class="tile"><span class="label">Tools & Tackels · Count</span><span class="value">@ViewBag.ToolCount</span></div><div class="tile"><span class="label">Tools & Tackels · Value</span><span class="value">₹@(((decimal)ViewBag.ToolValue).ToString("N2"))</span></div><div class="tile saffron"><span class="label">Provisional Profit / Loss</span><span class="value">₹@(((decimal)ViewBag.ProfitLoss).ToString("N2"))</span></div><div class="tile"><span class="label">Provisional P/L Ratio</span><span class="value">@(((decimal)ViewBag.ProfitLossRatio).ToString("N1"))%</span></div></div>
<div class="card"><div class="card-header"><h2>Project setup</h2><span class="tag">@Model.Status</span></div><div class="detail-grid"><div class="detail-item"><small>Client</small><strong>@Model.ClientName</strong></div><div class="detail-item"><small>Start date</small><strong>@Model.StartDate?.ToString("dd-MMM-yyyy")</strong></div><div class="detail-item"><small>Planned end date</small><strong>@Model.PlannedEndDate?.ToString("dd-MMM-yyyy")</strong></div><div class="detail-item"><small>Project store</small><strong>@store?.Name</strong></div><div class="detail-item"><small>Site address</small><strong>@Model.SiteAddress</strong></div><div class="detail-item"><small>Currency</small><strong>@Model.Currency</strong></div></div><h2 style="margin-top:24px">Towers / blocks</h2><div class="badge-row">@foreach(var t in Model.Towers){<span class="tag tag-blue">@t.Name (@t.Code)</span>}</div><p class="muted small" style="margin-top:16px">Assign users and tower scope in User Management → Project Assignments.</p></div>
