@model MaterialIndent
@{ ViewData["Title"] = "Indent details"; var approvals = ViewBag.Approvals as List<IndentApproval> ?? []; var tasks = ViewBag.Tasks as List<WorkTask> ?? []; bool canApprove = (bool)ViewBag.CanApprove; }
<div class="section-head"><div><h1>@Model.Number</h1><p class="subheading">Material Indent · @Model.Project?.Name · @Model.Tower?.Name</p></div><div class="btn-row"><a class="button button-light" asp-action="Index">All Indents</a><span class="tag @(Model.Status=="Issued"?"tag-green":Model.Status=="Rejected"?"tag-red":"tag-yellow")">@Model.Status</span></div></div>
<div class="tiles"><div class="tile"><span class="label">Material</span><span class="value" style="font-size:18px">@Model.Item?.Name</span><span class="hint">@Model.Item?.Code</span></div><div class="tile blue"><span class="label">Requested Quantity</span><span class="value">@Model.RequestedQuantity.ToString("0.####")</span><span class="hint">@Model.Item?.Unit?.Name</span></div><div class="tile green"><span class="label">Issued Quantity</span><span class="value">@Model.IssuedQuantity.ToString("0.####")</span><span class="hint">Remaining: @(Model.RequestedQuantity-Model.IssuedQuantity).ToString("0.####")</span></div><div class="tile saffron"><span class="label">Requester</span><span class="value" style="font-size:18px">@Model.RequestedBy?.DisplayName</span><span class="hint">@Model.RequestDate.ToString("dd-MMM-yyyy")</span></div></div>
<div class="split-grid"><div class="card"><h2>Request details</h2><div class="detail-grid"><div class="detail-item"><small>Project</small><strong>@Model.Project?.Name</strong></div><div class="detail-item"><small>Tower</small><strong>@(Model.Tower?.Name ?? "Project-wide")</strong></div><div class="detail-item"><small>Store</small><strong>@Model.StoreLocation?.Name</strong></div><div class="detail-item" style="grid-column:1/-1"><small>Purpose</small><strong>@Model.Purpose</strong></div></div>@if(canApprove && Model.Status is "PendingSupervisor" or "PendingEngineer"){<h2 style="margin-top:22px">Approval action</h2><form asp-action="Decide" method="post"><input type="hidden" name="id" value="@Model.Id"/><div class="field"><label>Decision</label><select name="decision"><option value="Approved">Approve</option><option value="Rejected">Reject</option></select></div><div class="field" style="margin-top:12px"><label>Remarks / rejection reason</label><textarea name="remarks"></textarea></div><div class="form-actions"><button class="button button-primary" type="submit">Submit decision</button></div></form>}</div>
<div class="card"><h2>Approval history</h2>@if(!approvals.Any()){<div class="empty-state">No approval has been recorded.</div>}else{<div class="table-wrap"><table><thead><tr><th>Stage</th><th>Approver</th><th>Decision</th><th>Date</th></tr></thead><tbody>@foreach(var a in approvals){<tr><td>@AppRoles.Label(a.Stage)</td><td>@a.Approver?.DisplayName</td><td><span class="tag @(a.Decision=="Approved"?"tag-green":"tag-red")">@a.Decision</span><div class="muted small">@a.Remarks</div></td><td>@a.DecidedAtUtc.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</td></tr>}</tbody></table></div>}<h2 style="margin-top:22px">Related tasks</h2>@if(!tasks.Any()){<div class="muted small">Task chain begins after final approval.</div>}else{<div class="table-wrap"><table><thead><tr><th>Task</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var t in tasks){<tr><td>@t.Title<div class="muted small">@t.Number</div></td><td>@AppRoles.Label(t.AssignedRole)</td><td><span class="tag">@t.Status</span></td><td><a class="button button-light button-sm" asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id">Open</a></td></tr>}</tbody></table></div>}</div></div>
