@model CreateIndentViewModel
@{ ViewData["Title"] = "Raise Indent"; var projects = ViewBag.Projects as List<Project> ?? []; var towers = ViewBag.Towers as List<Tower> ?? []; var items = ViewBag.Items as List<Item> ?? []; }
<div class="section-head"><div><h1>Raise material Indent</h1><p class="subheading">Select a material from available stock in the assigned project. One material per Indent; raise another Indent for additional materials.</p></div><a asp-action="Index" class="button button-light">Cancel</a></div><div class="card"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label asp-for="ProjectId">Assigned project *</label><select asp-for="ProjectId"><option value="">Select project</option>@foreach(var p in projects){<option value="@p.Id">@p.Name</option>}</select><span asp-validation-for="ProjectId" class="validation-message"></span></div><div class="field"><label asp-for="TowerId">Tower / work area</label><select asp-for="TowerId"><option value="">Not tower-specific</option>@foreach(var t in towers){<option value="@t.Id">@t.Project?.Name — @t.Name</option>}</select></div><div class="field wide"><label asp-for="ItemId">Material *</label><select asp-for="ItemId"><option value="">Select material</option>@foreach(var i in items){<option value="@i.Id">@i.Code — @i.Name (@i.Unit?.Code)</option>}</select><span asp-validation-for="ItemId" class="validation-message"></span></div><div class="field"><label asp-for="Quantity">Requested quantity *</label><input asp-for="Quantity" type="number" min="0.0001" step="0.0001"/><span asp-validation-for="Quantity" class="validation-message"></span></div><div class="field wide"><label asp-for="Purpose">Purpose / work activity</label><textarea asp-for="Purpose" placeholder="Describe the work for which material is needed"></textarea></div></div><div class="alert alert-info" style="margin-top:16px">Approval sequence: Site Supervisor → Engineer → Store In-charge. The material will not be issued before both approvals.</div><div class="form-actions"><button class="button button-primary" type="submit">Submit Indent</button></div></form></div>
