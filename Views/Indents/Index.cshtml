@model List<MaterialIndent>
@{ ViewData["Title"] = "Raised Indents"; var projects = ViewBag.Projects as List<Project> ?? []; int? projectId = ViewBag.ProjectId as int?; int? itemId = ViewBag.ItemId as int?; var status = ViewBag.Status as string ?? ""; }
<div class="section-head"><div><h1>Raised Indents</h1><p class="subheading">Requests are limited to assigned projects and towers. Material issue becomes available only after Supervisor and Engineer approvals.</p></div><a class="button button-primary" asp-action="Create" asp-route-projectId="@projectId">+ Raise Indent</a></div>
<div class="card"><form method="get" class="filters"><div class="field"><label>Project</label><select name="projectId"><option value="">All assigned projects</option>@foreach(var p in projects){<option value="@p.Id" selected="@(projectId==p.Id)">@p.Name</option>}</select></div><div class="field"><label>Status</label><select name="status"><option value="">All statuses</option>@foreach(var s in new[]{"PendingSupervisor","PendingEngineer","Approved","PartiallyIssued","Issued","Rejected","Cancelled"}){<option value="@s" selected="@(status==s)">@s</option>}</select></div><input type="hidden" name="itemId" value="@itemId"/><button class="button button-primary" type="submit">Filter</button><a class="button button-light" asp-action="Index">Clear</a></form><div class="table-wrap"><table><thead><tr><th>Indent</th><th>Project / Tower</th><th>Requester</th><th>Material</th><th class="number">Requested</th><th class="number">Issued</th><th class="number">Remaining</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var i in Model){<tr><td><a class="doc-link" asp-action="Details" asp-route-id="@i.Id">@i.Number</a><div class="muted small">@i.RequestDate.ToString("dd-MMM-yyyy")</div></td><td>@i.Project?.Name<div class="muted small">@i.Tower?.Name</div></td><td>@i.RequestedBy?.DisplayName</td><td><strong>@i.Item?.Name</strong><div class="muted small">@i.Item?.Code</div></td><td class="number">@i.RequestedQuantity.ToString("0.####") @i.Item?.Unit?.Code</td><td class="number">@i.IssuedQuantity.ToString("0.####")</td><td class="number">@(i.RequestedQuantity-i.IssuedQuantity).ToString("0.####")</td><td><span class="tag @(i.Status=="Issued"?"tag-green":i.Status=="Rejected"?"tag-red":i.Status.StartsWith("Pending")?"tag-yellow":"tag-blue")">@i.Status</span></td><td><a class="button button-light button-sm" asp-action="Details" asp-route-id="@i.Id">Open</a></td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="empty-state"><strong>No matching Indents</strong>Clear the filters or raise a material request for your assigned project.</div>}</div>
