@using AuditFlow.Web.Models
@{ ViewData["Title"] = "Reports"; var projects = ViewBag.Projects as List<Project> ?? []; }
<div class="section-head"><div><h1>Reports & exports</h1><p class="subheading">Export and review data from projects assigned to your active role.</p></div></div><div class="tiles"><div class="tile saffron"><span class="label">Open Indents</span><span class="value">@ViewBag.OpenIndents</span><a class="hint" asp-controller="Indents" asp-action="Index">Open Indents →</a></div><div class="tile blue"><span class="label">Pending Tasks</span><span class="value">@ViewBag.PendingTasks</span><a class="hint" asp-controller="Tasks" asp-action="Index">Open tasks →</a></div><div class="tile red"><span class="label">Open Findings</span><span class="value">@ViewBag.OpenFindings</span><a class="hint" asp-controller="Audits" asp-action="Index">Review findings →</a></div><div class="tile green"><span class="label">Net Receivable</span><span class="value">₹@(((decimal)ViewBag.NetReceivable).ToString("N2"))</span><span class="hint">Client RA bills in assigned projects</span></div></div>
<div class="card"><h2>Available reports</h2><div class="table-wrap"><table><thead><tr><th>Report</th><th>Contents</th><th>Format</th><th>Action</th></tr></thead><tbody><tr><td><strong>Project Inventory</strong></td><td>Material by project, total received, total issued, physical balance, reserved and available</td><td>CSV</td><td><a class="button button-primary button-sm" asp-action="InventoryCsv">Export</a></td></tr><tr><td><strong>Pending Tasks</strong></td><td>Task number, project, type, title, assigned role and status</td><td>CSV</td><td><a class="button button-primary button-sm" asp-action="PendingTasksCsv">Export</a></td></tr><tr><td><strong>Received Stock Matrix</strong></td><td>Accepted receipts from verified GRNs, filtered by project/material</td><td>Screen</td><td><a class="button button-light button-sm" asp-controller="Inventory" asp-action="Matrix" asp-route-kind="received">Open</a></td></tr><tr><td><strong>Issued Stock Matrix</strong></td><td>Completed material issues and related Indents</td><td>Screen</td><td><a class="button button-light button-sm" asp-controller="Inventory" asp-action="Matrix" asp-route-kind="issued">Open</a></td></tr><tr><td><strong>Client Billing Register</strong></td><td>RA bills, adjustments, receipts, and balance</td><td>Screen</td><td><a class="button button-light button-sm" asp-controller="Billing" asp-action="Index">Open</a></td></tr><tr><td><strong>Audit Findings</strong></td><td>Open, overdue and closed findings</td><td>Screen</td><td><a class="button button-light button-sm" asp-controller="Audits" asp-action="Index">Open</a></td></tr></tbody></table></div><p class="muted small" style="margin-top:12px">CSV exports are generated from the current database at download time. Advanced profitability, supplier aging, RA bill aging, labour productivity and monthly trends are planned extensions.</p></div>
