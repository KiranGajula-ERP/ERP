@model List<AuditFlow.Web.Models.AuditLog>
@{ ViewData["Title"] = "Audit Trail"; var q = ViewBag.Query as string ?? ""; int page = ViewBag.Page; int pages = ViewBag.TotalPages; }
<div class="section-head"><div><h1>Audit Trail</h1><p class="subheading">Append-only business activity log for key stock, approval, document and billing actions.</p></div></div>
<div class="card"><form method="get" class="filters"><div class="field"><label>Search audit trail</label><input name="q" value="@q" placeholder="Action, user, reference or details" /></div><button class="button button-primary" type="submit">Search</button><a class="button button-light" asp-action="Index">Clear</a></form><div class="table-wrap"><table><thead><tr><th>Timestamp (UTC)</th><th>User</th><th>Action</th><th>Entity</th><th>Reference</th><th>Details</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@(x.User?.DisplayName ?? "System")</td><td><span class="tag">@x.Action</span></td><td>@x.EntityType #@x.EntityId</td><td>@x.ReferenceNumber</td><td>@x.Details</td></tr>}</tbody></table></div><div class="pagination"><span>Page @page of @pages</span><div class="btn-row">@if(page>1){<a class="button button-light button-sm" asp-action="Index" asp-route-q="@q" asp-route-page="@(page-1)">Previous</a>}@if(page<pages){<a class="button button-light button-sm" asp-action="Index" asp-route-q="@q" asp-route-page="@(page+1)">Next</a>}</div></div></div>
