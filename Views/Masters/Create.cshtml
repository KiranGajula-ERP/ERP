@model CreateMasterEntryViewModel
@{ ViewData["Title"] = "Create master"; var cats = ViewBag.Categories as string[] ?? []; }
<div class="section-head"><div><h1>Create master record</h1><p class="subheading">Use a stable code and avoid duplicate meanings for the same reference data.</p></div><a asp-action="Index" asp-route-category="@Model.Category" class="button button-light">Cancel</a></div><div class="card"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label>Category *</label><select asp-for="Category">@foreach(var c in cats){<option>@c</option>}</select></div><div class="field"><label>Code</label><input asp-for="Code"/></div><div class="field"><label>Name *</label><input asp-for="Name"/><span asp-validation-for="Name" class="validation-message"></span></div><div class="field wide"><label>Details / default terms</label><textarea asp-for="Details"></textarea></div></div><div class="form-actions"><button class="button button-primary" type="submit">Save master</button></div></form></div>
