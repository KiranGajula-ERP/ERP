@model CreateItemViewModel
@{ ViewData["Title"] = "Create item"; var units = ViewBag.Units as List<Unit> ?? []; var cats = ViewBag.ItemCategories as List<ItemCategory> ?? []; var brands = ViewBag.Brands as List<Brand> ?? []; }
<div class="section-head"><div><h1>Create material / tool</h1><p class="subheading">Item code should be unique and the unit must match the stock unit you use on site.</p></div><a asp-action="Index" asp-route-category="Items" class="button button-light">Cancel</a></div><div class="card"><form asp-action="CreateItem" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label>Item code *</label><input asp-for="Code"/></div><div class="field"><label>Item name *</label><input asp-for="Name"/></div><div class="field"><label>Unit *</label><select asp-for="UnitId">@foreach(var u in units){<option value="@u.Id">@u.Code — @u.Name</option>}</select></div><div class="field"><label>Category</label><select asp-for="CategoryId"><option value="">None</option>@foreach(var c in cats){<option value="@c.Id">@c.Name</option>}</select></div><div class="field"><label>Brand</label><select asp-for="BrandId"><option value="">None</option>@foreach(var b in brands){<option value="@b.Id">@b.Name</option>}</select></div><div class="field"><label class="checkline"><input asp-for="IsToolOrAsset"/> Tool / equipment</label><label class="checkline"><input asp-for="RequiresSerialNumber"/> Requires serial number</label></div><div class="field wide"><label>Description</label><textarea asp-for="Description"></textarea></div></div><div class="form-actions"><button class="button button-primary" type="submit">Create item</button></div></form></div>
