@{ ViewData["Title"] = "Masters"; var cats = ViewBag.Categories as string[] ?? []; var category = (string)ViewBag.Category; var entries = ViewBag.Entries as List<MasterEntry> ?? []; var items = ViewBag.Items as List<Item> ?? []; var units = ViewBag.Units as List<Unit> ?? []; var suppliers = ViewBag.Suppliers as List<Supplier> ?? []; var customers = ViewBag.Customers as List<Customer> ?? []; }
<div class="section-head"><div><h1>Masters</h1><p class="subheading">Maintain reusable reference data. Prefer deactivation to deleting records already used in transactions.</p></div><div class="btn-row"><a asp-action="CreateItem" class="button button-primary">+ Create item</a><a asp-action="Create" asp-route-category="@category" class="button button-light">+ Create @category</a></div></div>
<div class="card"><div class="filters">@foreach(var c in cats){<a class="pill-link" asp-action="Index" asp-route-category="@c">@c</a>}</div><div class="card-header"><h2>@category</h2><span class="tag">Masters / reference data</span></div>
@if(category=="Items"){<div class="table-wrap"><table><thead><tr><th>Code</th><th>Item</th><th>Unit</th><th>Category</th><th>Brand</th><th>Type</th></tr></thead><tbody>@foreach(var i in items){<tr><td>@i.Code</td><td><strong>@i.Name</strong><div class="muted small">@i.Description</div></td><td>@i.Unit?.Name</td><td>@i.Category?.Name</td><td>@i.Brand?.Name</td><td>@(i.IsToolOrAsset?"Tool / asset":"Material")</td></tr>}</tbody></table></div>}
else if(category=="Units"){<div class="table-wrap"><table><thead><tr><th>Code</th><th>Unit</th></tr></thead><tbody>@foreach(var u in units){<tr><td>@u.Code</td><td>@u.Name</td></tr>}</tbody></table></div>}
else if(category=="Brands"){<div class="table-wrap"><table><thead><tr><th>Brand</th></tr></thead><tbody>@foreach(var b in (ViewBag.Brands as List<Brand> ?? [])){<tr><td>@b.Name</td></tr>}</tbody></table></div>}
else if(category=="Item Categories"){<div class="table-wrap"><table><thead><tr><th>Category</th></tr></thead><tbody>@foreach(var b in (ViewBag.ItemCategories as List<ItemCategory> ?? [])){<tr><td>@b.Name</td></tr>}</tbody></table></div>}
else if(category=="Suppliers"){<div class="table-wrap"><table><thead><tr><th>Supplier</th><th>Code</th><th>Contact</th><th>GSTIN</th></tr></thead><tbody>@foreach(var s in suppliers){<tr><td>@s.Name</td><td>@s.Code</td><td>@s.ContactPerson · @s.Phone</td><td>@s.GSTIN</td></tr>}</tbody></table></div><p class="muted small">For full supplier records use <a asp-controller="Suppliers" asp-action="Index">Supplier register</a>.</p>}
else if(category=="Customers"){<div class="table-wrap"><table><thead><tr><th>Customer</th><th>Code</th><th>GSTIN</th><th>Phone</th></tr></thead><tbody>@foreach(var c in customers){<tr><td>@c.Name</td><td>@c.Code</td><td>@c.GSTIN</td><td>@c.ContactPhone</td></tr>}</tbody></table></div><p class="muted small">For full customer records use <a asp-controller="Customers" asp-action="Index">Customer register</a>.</p>}
else{<div class="table-wrap"><table><thead><tr><th>Code</th><th>Name</th><th>Details</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var e in entries){<tr><td>@e.Code</td><td>@e.Name</td><td>@e.Details</td><td><span class="tag tag-green">Active</span></td><td><form asp-action="DeactivateEntry" method="post"><input type="hidden" name="id" value="@e.Id"/><button class="button button-danger button-sm" type="submit" data-confirm="Deactivate this master record?">Deactivate</button></form></td></tr>}</tbody></table></div>}
</div>
