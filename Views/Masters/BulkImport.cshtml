@model MasterBulkImportViewModel
@{ ViewData["Title"] = "Bulk import masters"; var categories = ViewBag.Categories as string[] ?? []; var errors = ViewBag.ImportErrors as List<string> ?? []; }
<div class="section-head"><div><h1>Bulk import masters</h1><p class="subheading">Import reference data from UTF-8 CSV files. Existing duplicate codes or names are skipped; row errors are listed after processing.</p></div><a asp-action="Index" asp-route-category="@Model.Category" class="button button-light">Back to Masters</a></div>
<div class="card form-card"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><form asp-action="BulkImport" method="post" enctype="multipart/form-data"><div class="field"><label asp-for="Category">Master category</label><select asp-for="Category">@foreach(var c in categories){<option value="@c">@c</option>}</select><span asp-validation-for="Category" class="validation-message"></span></div><div class="field"><label asp-for="File">CSV file</label><input asp-for="File" type="file" accept=".csv,text/csv"/><span asp-validation-for="File" class="validation-message"></span><small class="muted">Maximum 10 MB and 2,000 data rows per import. Download the category template first.</small></div><div class="btn-row"><button class="button button-primary" type="submit">Import CSV</button><a asp-action="DownloadTemplate" asp-route-category="@Model.Category" class="button button-light">Download CSV template</a></div></form></div>
@if(ViewBag.Inserted is int inserted){<div class="tiles"><div class="tile green"><span class="label">Added</span><span class="value">@inserted</span></div><div class="tile"><span class="label">Duplicates skipped</span><span class="value">@((int?)ViewBag.Skipped ?? 0)</span></div><div class="tile red"><span class="label">Row errors (shown up to 100)</span><span class="value">@errors.Count</span></div></div>}
@if(errors.Count>0){<div class="card"><h2>Rows needing correction</h2><ul>@foreach(var e in errors){<li>@e</li>}</ul></div>}
<div class="card"><h2>CSV column formats</h2><p class="muted small">Items: Code, Name, UnitCode, Category, Brand, IsToolOrAsset, RequiresSerialNumber, Description. Units: Code, Name. Brands / Item Categories: Name. Suppliers: Code, Name, ContactPerson, Phone, Email, GSTIN, Address. Customers: Code, Name, GSTIN, BillingAddress, ContactEmail, ContactPhone. Other categories: Code, Name, Details. Column headers are required.</p></div>
