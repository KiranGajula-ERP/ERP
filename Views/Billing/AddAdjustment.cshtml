@model CreateBillAdjustmentViewModel
@{ ViewData["Title"] = "Add bill adjustment"; }
<div class="section-head"><div><h1>Add addition or deduction</h1><p class="subheading">Configure retention, TDS, PBG, LC hold, client supply recovery, penalty, or any custom line.</p></div><a asp-action="Details" asp-route-id="@Model.BillId" class="button button-light">Back to bill</a></div><div class="card"><form asp-action="AddAdjustment" method="post"><input asp-for="BillId" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label>Description *</label><input asp-for="Description" placeholder="Retention 5%, TDS 2%, LC Hold…"/></div><div class="field"><label>Type</label><select asp-for="AdjustmentType"><option>Deduction</option><option>Addition</option></select></div><div class="field"><label>Rate (%)</label><input asp-for="RatePercent" type="number" min="0" max="100" step="0.01"/></div><div class="field"><label>Amount (₹)</label><input asp-for="Amount" type="number" min="0" step="0.01"/></div><div class="field wide"><label>Calculation note</label><textarea asp-for="CalculationNote"></textarea></div></div><div class="form-actions"><button class="button button-primary" type="submit">Save adjustment</button></div></form></div>
