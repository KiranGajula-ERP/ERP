@model CreateReceiptViewModel
@{ ViewData["Title"] = "Record client receipt"; }
<div class="section-head"><div><h1>Record client receipt</h1><p class="subheading">Enter account-team and bank-statement references. The outstanding balance recalculates after save.</p></div><a asp-action="Details" asp-route-id="@Model.BillId" class="button button-light">Back to bill</a></div><div class="card"><form asp-action="AddReceipt" method="post"><input asp-for="BillId" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label>Receipt date</label><input asp-for="ReceiptDate" type="date"/></div><div class="field"><label>Amount received (₹) *</label><input asp-for="Amount" type="number" min="0.01" step="0.01"/></div><div class="field"><label>Accounts team reference</label><input asp-for="AccountsReference"/></div><div class="field"><label>Bank statement reference</label><input asp-for="BankReference"/></div><div class="field wide"><label>Notes</label><textarea asp-for="Notes"></textarea></div></div><div class="form-actions"><button class="button button-primary" type="submit">Save receipt</button></div></form></div>
