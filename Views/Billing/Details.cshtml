@model ClientRABill
@{ ViewData["Title"] = "RA Bill details"; var adjustments = ViewBag.Adjustments as List<BillAdjustment> ?? []; var receipts = ViewBag.Receipts as List<ClientReceipt> ?? []; }
<div class="section-head"><div><h1>@Model.Number</h1><p class="subheading">Client Billing Register · @Model.Project?.Name · @Model.BillDate.ToString("dd-MMM-yyyy")</p></div><div class="btn-row"><a asp-action="Index" class="button button-light">Back to register</a><a asp-controller="Documents" asp-action="Create" asp-route-projectId="@Model.ProjectId" class="button button-light">Attach supporting document</a></div></div>
<div class="tiles"><div class="tile blue"><span class="label">Net Amount</span><span class="value">₹@Model.NetAmount.ToString("N2")</span></div><div class="tile saffron"><span class="label">Net Receivable Amount</span><span class="value">₹@Model.NetReceivable.ToString("N2")</span></div><div class="tile green"><span class="label">Received Amount</span><span class="value">₹@Model.ReceivedAmount.ToString("N2")</span></div><div class="tile red"><span class="label">Outstanding Balance</span><span class="value">₹@(((decimal)ViewBag.Balance).ToString("N2"))</span></div></div>
<div class="card"><div class="card-header"><h2>Bill calculation</h2><span class="tag @(Model.JmrStatus=="Received"?"tag-green":"tag-yellow")">JMR @Model.JmrStatus</span></div><div class="detail-grid"><div class="detail-item"><small>RA Bill Basic Amount</small><strong>₹@Model.BasicAmount.ToString("N2")</strong></div><div class="detail-item"><small>Mobilisation Advance</small><strong>₹@Model.MobilisationAdvance.ToString("N2")</strong></div><div class="detail-item"><small>Gross Bill Amount</small><strong>₹@Model.GrossAmount.ToString("N2")</strong></div><div class="detail-item"><small>SGST</small><strong>₹@Model.SgstAmount.ToString("N2")</strong></div><div class="detail-item"><small>CGST</small><strong>₹@Model.CgstAmount.ToString("N2")</strong></div><div class="detail-item"><small>Total deductions</small><strong>₹@Model.TotalDeductions.ToString("N2")</strong></div><div class="detail-item"><small>Retention</small><strong>₹@Model.RetentionAmount.ToString("N2")</strong></div><div class="detail-item"><small>Other holds</small><strong>₹@Model.HoldAmount.ToString("N2")</strong></div><div class="detail-item"><small>JMR reference</small><strong>@(string.IsNullOrWhiteSpace(Model.JmrReference)?"Pending":Model.JmrReference)</strong></div></div></div>
<div class="split-grid"><div class="card"><div class="card-header"><h2>Additions & deductions</h2><a asp-action="AddAdjustment" asp-route-billId="@Model.Id" class="button button-primary button-sm">+ Add row</a></div><div class="table-wrap"><table><thead><tr><th>Description</th><th>Type</th><th class="number">Rate</th><th class="number">Amount</th></tr></thead><tbody>@foreach(var a in adjustments){<tr><td>@a.Description<div class="muted small">@a.CalculationNote</div></td><td><span class="tag @(a.AdjustmentType=="Addition"?"tag-green":"tag-red")">@a.AdjustmentType</span></td><td class="number">@a.RatePercent.ToString("0.##")%</td><td class="number">₹@a.Amount.ToString("N2")</td></tr>}</tbody></table></div></div>
<div class="card"><div class="card-header"><h2>Received details</h2><a asp-action="AddReceipt" asp-route-billId="@Model.Id" class="button button-primary button-sm">+ Record receipt</a></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>Accounts reference</th><th>Bank reference</th><th class="number">Amount</th></tr></thead><tbody>@foreach(var r in receipts){<tr><td>@r.ReceiptDate.ToString("dd-MMM-yyyy")</td><td>@r.AccountsReference</td><td>@r.BankReference</td><td class="number">₹@r.Amount.ToString("N2")</td></tr>}</tbody></table></div></div></div>
