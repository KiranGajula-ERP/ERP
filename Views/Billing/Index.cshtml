@model List<ClientRABill>
@{ ViewData["Title"] = "Client Billing"; var projects = ViewBag.Projects as List<Project> ?? []; int? projectId = ViewBag.ProjectId as int?; var status = ViewBag.Status as string ?? ""; }
<div class="section-head"><div><h1>Client Billing Register</h1><p class="subheading">RA bills, additions, deductions, receipts and outstanding balances.</p></div><a asp-action="Create" class="button button-primary">+ Create RA bill</a></div><div class="card"><form method="get" class="filters"><div class="field"><label>Project</label><select name="projectId"><option value="">All assigned projects</option>@foreach(var p in projects){<option value="@p.Id" selected="@(projectId==p.Id)">@p.Name</option>}</select></div><div class="field"><label>Status</label><select name="status"><option value="">All statuses</option>@foreach(var s in new[]{"Draft","Submitted","Approved","PartPaid","Paid","Rejected"}){<option value="@s" selected="@(status==s)">@s</option>}</select></div><button type="submit" class="button button-primary">Filter</button><a asp-action="Index" class="button button-light">Clear</a></form><div class="table-wrap"><table><thead><tr><th>RA Bill</th><th>Project</th><th>Bill date</th><th class="number">Net amount</th><th class="number">Deductions</th><th class="number">Net receivable</th><th class="number">Received</th><th class="number">Balance</th><th>JMR</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var b in Model){<tr><td><a class="doc-link" asp-action="Details" asp-route-id="@b.Id">@b.Number</a></td><td>@b.Project?.Name</td><td>@b.BillDate.ToString("dd-MMM-yyyy")</td><td class="number">₹@b.NetAmount.ToString("N2")</td><td class="number">₹@b.TotalDeductions.ToString("N2")</td><td class="number">₹@b.NetReceivable.ToString("N2")</td><td class="number">₹@b.ReceivedAmount.ToString("N2")</td><td class="number">₹@(b.NetReceivable-b.ReceivedAmount).ToString("N2")</td><td><span class="tag @(b.JmrStatus=="Received"?"tag-green":"tag-yellow")">@b.JmrStatus</span></td><td><span class="tag">@b.Status</span></td><td><a class="button button-light button-sm" asp-action="Details" asp-route-id="@b.Id">Open</a></td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="empty-state"><strong>No RA bills found</strong>Create the first bill or select another project.</div>}</div>
