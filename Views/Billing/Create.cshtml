@model CreateBillViewModel
@{ ViewData["Title"] = "Create RA Bill"; var projects = ViewBag.Projects as List<Project> ?? []; }
<div class="section-head"><div><h1>Create Client RA Bill</h1><p class="subheading">Billing can proceed before JMR is received after the Engineer checklist and Client approval stage.</p></div><a asp-action="Index" class="button button-light">Cancel</a></div><div class="card"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label>Project *</label><select asp-for="ProjectId">@foreach(var p in projects){<option value="@p.Id">@p.Name</option>}</select></div><div class="field"><label>RA bill number *</label><input asp-for="Number" placeholder="RA-01"/></div><div class="field"><label>Bill date</label><input asp-for="BillDate" type="date"/></div><div class="field"><label>Basic RA bill amount (₹)</label><input asp-for="BasicAmount" type="number" min="0" step="0.01"/></div><div class="field"><label>Mobilisation advance amount (₹)</label><input asp-for="MobilisationAdvance" type="number" min="0" step="0.01"/></div><div class="field"><label>SGST (₹)</label><input asp-for="SgstAmount" type="number" min="0" step="0.01"/></div><div class="field"><label>CGST (₹)</label><input asp-for="CgstAmount" type="number" min="0" step="0.01"/></div><div class="field"><label>JMR reference (optional)</label><input asp-for="JmrReference" placeholder="Leave blank if JMR is pending"/></div><input asp-for="WorkTaskId" type="hidden"/></div><div class="alert alert-info" style="margin-top:15px">Calculation: Gross = Basic amount + Mobilisation advance. Net amount = Gross + SGST + CGST. Configure additional additions and deductions on the bill detail screen.</div><div class="form-actions"><button class="button button-primary" type="submit">Create RA Bill</button></div></form></div>
