@model WorkTask
@{ ViewData["Title"] = "Task details"; bool canAct = Model.Status is "Pending" or "InProgress"; var role = User.FindFirst("activeRole")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? ""; }
<div class="section-head"><div><h1>@Model.Title</h1><p class="subheading">@Model.Number · @Model.Project?.Name · @Model.Tower?.Name</p></div><div class="btn-row"><a class="button button-light" asp-action="Index">Back to tasks</a><span class="tag @(Model.Status=="Completed"?"tag-green":"tag-yellow")">@Model.Status</span></div></div>
<div class="card"><div class="detail-grid"><div class="detail-item"><small>Task type</small><strong>@Model.TaskType</strong></div><div class="detail-item"><small>Assigned role</small><strong>@AppRoles.Label(Model.AssignedRole)</strong></div><div class="detail-item"><small>Assigned user</small><strong>@(Model.AssignedUser?.DisplayName ?? "Role queue")</strong></div><div class="detail-item"><small>Related Indent</small><strong>@if(Model.MaterialIndentId.HasValue){<a asp-controller="Indents" asp-action="Details" asp-route-id="@Model.MaterialIndentId">@Model.MaterialIndent?.Number</a>}else{<text>—</text>}</strong></div><div class="detail-item"><small>Created</small><strong>@Model.CreatedAtUtc.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</strong></div><div class="detail-item"><small>Due date</small><strong>@Model.DueDate?.ToString("dd-MMM-yyyy")</strong></div><div class="detail-item" style="grid-column:1/-1"><small>Instructions</small><strong>@Model.Description</strong></div></div></div>
<div class="split-grid"><div class="card"><h2>Task completion</h2>@if(!canAct){<div class="alert alert-info">This task is closed. The completion details are retained below.</div>}else if(role != Model.AssignedRole && Model.AssignedUserId != int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0") && role != AppRoles.SystemAdministrator){<div class="alert alert-info">This task is assigned to @AppRoles.Label(Model.AssignedRole). Switch to that role or contact your administrator if the assignment is incorrect.</div>}else if(Model.TaskType == "Billing"){<p>Create the client RA bill from this task. Completing the bill form will close this billing task.</p><a class="button button-primary" asp-controller="Billing" asp-action="Create" asp-route-projectId="@Model.ProjectId" asp-route-taskId="@Model.Id">Prepare RA bill</a>}else{<form asp-action="Complete" method="post" enctype="multipart/form-data"><input type="hidden" name="Id" value="@Model.Id"/><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>@if(Model.TaskType=="StoreIssue" && Model.MaterialIndent is not null){<div class="alert alert-info">Issue against @Model.MaterialIndent.Number. Requested: @Model.MaterialIndent.RequestedQuantity; issued: @Model.MaterialIndent.IssuedQuantity; remaining: @(Model.MaterialIndent.RequestedQuantity-Model.MaterialIndent.IssuedQuantity). Use the actual quantity packed and handed over.</div><div class="field"><label>Quantity issued now</label><input name="IssueQuantity" type="number" min="0.0001" max="@(Model.MaterialIndent.RequestedQuantity-Model.MaterialIndent.IssuedQuantity)" step="0.0001" value="@(Model.MaterialIndent.RequestedQuantity-Model.MaterialIndent.IssuedQuantity)"/></div>}@if(Model.TaskType=="SupervisorReview"){<div class="field"><label>Review decision</label><select name="Decision"><option value="Approved">Approve work</option><option value="Rejected">Return for correction</option></select></div>}else{<input type="hidden" name="Decision" value="Approved"/>}<div class="field" style="margin-top:12px"><label>Completion remarks / checklist / JMR reference *</label><textarea name="Remarks" placeholder="Enter work details, checklist reference, Client approval, JMR number, or issue notes as applicable">@Model.CompletionRemarks</textarea></div>@if(Model.TaskType is "WorkExecution" or "SupervisorReview" or "EngineerChecklist" or "JMR"){<div class="field" style="margin-top:12px"><label>Attach photographs or signed documents</label><input type="file" name="Files" multiple accept=".jpg,.jpeg,.png,.webp,.pdf"/><small class="muted">JPG, PNG, WebP or PDF · maximum 15 MB each. Work completion and Supervisor review require at least one image photograph; JMR/checklist documents may be PDFs.</small></div>}<div class="form-actions"><button type="submit" class="button button-primary">Save and continue workflow</button></div></form>}</div>
<div class="card"><h2>Attachments & completion history</h2>@if(!Model.Attachments.Any()){<div class="empty-state">No attachments uploaded yet.</div>}else{<div class="table-wrap"><table><thead><tr><th>File</th><th>Size</th><th>Uploaded</th><th></th></tr></thead><tbody>@foreach(var a in Model.Attachments){<tr><td>@a.OriginalFileName</td><td>@((a.SizeBytes/1024.0).ToString("N0")) KB</td><td>@a.CreatedAtUtc.ToLocalTime().ToString("dd-MMM-yyyy")</td><td><a class="button button-light button-sm" asp-action="Attachment" asp-route-id="@a.Id">Open file</a></td></tr>}</tbody></table></div>}<p class="muted small">Status: @Model.Status · Completed by: @Model.CompletedBy?.DisplayName · @Model.CompletedAtUtc?.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</p><p>@Model.CompletionRemarks</p></div></div>
