@model List<WorkTask>
@{ ViewData["Title"] = "Pending Tasks"; var projects = ViewBag.Projects as List<Project> ?? []; int? projectId = ViewBag.ProjectId as int?; var status = ViewBag.Status as string ?? ""; }
<div class="section-head"><div><h1>Pending Tasks</h1><p class="subheading">Task visibility is based on your active role, assigned projects and tower scope.</p></div><div class="btn-row"><a class="button button-light" asp-controller="Inventory" asp-action="Index">Project inventory</a><a class="button button-light" asp-controller="Indents" asp-action="Index">Raised Indents</a></div></div>
<div class="card"><form method="get" class="filters"><div class="field"><label>Project</label><select name="projectId"><option value="">All assigned projects</option>@foreach(var p in projects){<option value="@p.Id" selected="@(projectId==p.Id)">@p.Name</option>}</select></div><div class="field"><label>Status</label><select name="status"><option value="">All statuses</option>@foreach(var st in new[]{"Pending","Completed","Rejected","Cancelled"}){<option value="@st" selected="@(status==st)">@st</option>}</select></div><button class="button button-primary" type="submit">Filter tasks</button><a class="button button-light" asp-action="Index">Clear</a></form><div class="table-wrap"><table><thead><tr><th>Task</th><th>Project / tower</th><th>Assigned to</th><th>Task type</th><th>Created</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var t in Model){<tr><td><strong>@t.Title</strong><div class="muted small">@t.Number</div></td><td>@t.Project?.Name<div class="muted small">@t.Tower?.Name</div></td><td>@(t.AssignedUser?.DisplayName ?? AppRoles.Label(t.AssignedRole))</td><td><span class="tag tag-blue">@t.TaskType</span></td><td>@t.CreatedAtUtc.ToLocalTime().ToString("dd-MMM-yyyy")</td><td><span class="tag @(t.Status=="Completed"?"tag-green":t.Status=="Rejected"?"tag-red":"tag-yellow")">@t.Status</span></td><td><a class="button button-light button-sm" asp-action="Details" asp-route-id="@t.Id">Open</a></td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="empty-state"><strong>No tasks found</strong>When workflow stages complete, new tasks are automatically assigned to the appropriate roles.</div>}</div>
