@using AuditFlow.Web.Models
@{ ViewData["Title"] = "Dashboard"; var indents = ViewBag.RecentIndents as List<MaterialIndent> ?? []; var tasks = ViewBag.RecentTasks as List<WorkTask> ?? []; }
<div class="section-head"><div><h1>Good day, @User.Identity?.Name</h1><p class="subheading">Your @ViewBag.RoleLabel workspace · Tasks and data are scoped to your current role and assignments.</p></div><div class="btn-row">@if(User.IsInRole(AppRoles.Worker)||User.IsInRole(AppRoles.Subcontractor)||User.IsInRole(AppRoles.SystemAdministrator)){<a class="button button-primary" asp-controller="Indents" asp-action="Create">+ Raise Indent</a>}<a class="button button-light" asp-controller="Projects" asp-action="Index">View projects</a></div></div>
<div class="tiles"><div class="tile saffron"><span class="label">Assigned Projects</span><span class="value">@ViewBag.ProjectCount</span><span class="hint">Projects in your active role</span></div><div class="tile blue"><span class="label">Pending Tasks</span><span class="value">@ViewBag.PendingTasks</span><a class="hint" asp-controller="Tasks" asp-action="Index">Open task list →</a></div><div class="tile"><span class="label">Open Indents</span><span class="value">@ViewBag.PendingIndents</span><a class="hint" asp-controller="Indents" asp-action="Index">Review Indents →</a></div><div class="tile red"><span class="label">Open Findings</span><span class="value">@ViewBag.OpenFindings</span><a class="hint" asp-controller="Audits" asp-action="Index">View audit findings →</a></div></div>
@if ((bool)ViewBag.CanSeeStockTiles){<div class="tiles"><a class="tile blue" asp-controller="Inventory" asp-action="Matrix" asp-route-kind="received"><span class="label">Total Received</span><span class="value">₹@(((decimal)ViewBag.TotalReceived).ToString("N2"))</span><span class="hint">Open received stock breakdown →</span></a><a class="tile saffron" asp-controller="Inventory" asp-action="Matrix" asp-route-kind="issued"><span class="label">Total Issued</span><span class="value">₹@(((decimal)ViewBag.TotalIssued).ToString("N2"))</span><span class="hint">Open issued stock breakdown →</span></a><a class="tile green" asp-controller="Inventory" asp-action="Index"><span class="label">Balance Available Stock</span><span class="value">₹@(((decimal)ViewBag.BalanceStock).ToString("N2"))</span><span class="hint">Open project inventory →</span></a><div class="tile"><span class="label">Total Contract Value</span><span class="value">₹@(((decimal)ViewBag.TotalContractValue).ToString("N0"))</span><span class="hint">Across your assigned projects</span></div></div>}
@if ((bool)ViewBag.CanSeeManagementTiles){
<div class="section-head" style="margin-top:24px"><div><h2>Company performance snapshot</h2><p class="subheading">Cumulative values across projects visible to management. These are operational indicators, not a substitute for the accounting ledger.</p></div></div>
<div class="tiles"><a class="tile blue" asp-controller="Billing" asp-action="Index"><span class="label">Revenue Billed</span><span class="value">₹@(((decimal)ViewBag.RevenueBilled).ToString("N2"))</span><span class="hint">Client RA bills →</span></a><a class="tile green" asp-controller="Billing" asp-action="Index"><span class="label">Revenue Collected</span><span class="value">₹@(((decimal)ViewBag.RevenueCollected).ToString("N2"))</span><span class="hint">Client receipts →</span></a><a class="tile" asp-controller="Procurement" asp-action="Index"><span class="label">Purchase / Supply Value</span><span class="value">₹@(((decimal)ViewBag.PurchaseSupplyValue).ToString("N2"))</span><span class="hint">Approved Purchase Orders →</span></a><a class="tile saffron" asp-controller="Inventory" asp-action="Matrix" asp-route-kind="issued"><span class="label">Material Used Value</span><span class="value">₹@(((decimal)ViewBag.UsedMaterialValue).ToString("N2"))</span><span class="hint">Issued stock at recorded cost →</span></a><a class="tile red" asp-controller="Inventory" asp-action="Matrix" asp-route-kind="wastage"><span class="label">Wastage Value</span><span class="value">₹@(((decimal)ViewBag.WastageValue).ToString("N2"))</span><span class="hint">Posted wastage movements →</span></a><a class="tile" asp-controller="Expenses" asp-action="Index"><span class="label">Overheads</span><span class="value">₹@(((decimal)ViewBag.OverheadsValue).ToString("N2"))</span><span class="hint">Project overhead expenses →</span></a><a class="tile" asp-controller="Expenses" asp-action="Index" asp-route-category="Transportation"><span class="label">Transportation</span><span class="value">₹@(((decimal)ViewBag.TransportationValue).ToString("N2"))</span><span class="hint">Transportation expenses →</span></a><a class="tile" asp-controller="Inventory" asp-action="Index"><span class="label">Tools & Tackels — Count</span><span class="value">@ViewBag.ToolSkuCount</span><span class="hint">Tool / asset SKUs with positive stock</span></a><a class="tile" asp-controller="Inventory" asp-action="Index"><span class="label">Tools & Tackels — Value</span><span class="value">₹@(((decimal)ViewBag.ToolAmount).ToString("N2"))</span><span class="hint">Estimated tool stock value →</span></a><a class="tile saffron"><span class="label">Provisional Profit / Loss</span><span class="value">₹@(((decimal)ViewBag.ProvisionalProfitLoss).ToString("N2"))</span><span class="hint">Material use + posted expenses + wastage</span></a><div class="tile"><span class="label">Provisional Profit / Loss Ratio</span><span class="value">@(((decimal)ViewBag.ProfitLossRatio).ToString("N1"))%</span><span class="hint">Based on billed revenue</span></div></div>
}
<div class="split-grid"><div class="card"><div class="card-header"><h2>My pending tasks</h2><a asp-controller="Tasks" asp-action="Index" class="button button-light button-sm">View all</a></div>@if (!tasks.Any()){<div class="empty-state"><strong>No pending tasks shown</strong>Tasks assigned to your current role and project assignments appear here.</div>}else{<div class="table-wrap"><table><thead><tr><th>Task</th><th>Project</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var task in tasks){<tr><td><strong>@task.Title</strong><div class="muted small">@task.Number</div></td><td>@task.Project?.Name</td><td><span class="tag tag-yellow">@task.Status</span></td><td><a class="button button-light button-sm" asp-controller="Tasks" asp-action="Details" asp-route-id="@task.Id">Open</a></td></tr>}</tbody></table></div>}</div>
<div class="card"><div class="card-header"><h2>Recent Indents</h2><a asp-controller="Indents" asp-action="Index" class="button button-light button-sm">View all</a></div>@if (!indents.Any()){<div class="empty-state"><strong>No Indents yet</strong>Approved material requests will flow into Store Issue tasks.</div>}else{<div class="table-wrap"><table><thead><tr><th>Indent</th><th>Material</th><th>Status</th></tr></thead><tbody>@foreach(var i in indents){<tr><td><a class="doc-link" asp-controller="Indents" asp-action="Details" asp-route-id="@i.Id">@i.Number</a><div class="muted small">@i.Project?.Name</div></td><td>@i.Item?.Name<div class="muted small">@i.RequestedQuantity @i.Item?.Unit?.Code</div></td><td><span class="tag">@i.Status</span></td></tr>}</tbody></table></div>}</div></div>
<div class="card"><div class="card-header"><h2>Workflow at a glance</h2><span class="tag tag-blue">JMR and Billing can run in parallel</span></div><div class="workflow-steps"><div class="workflow-step"><span class="step-num">01</span><strong>Raise Indent</strong><small>Worker / subcontractor</small></div><div class="workflow-step"><span class="step-num">02</span><strong>Approvals</strong><small>Supervisor → Engineer</small></div><div class="workflow-step"><span class="step-num">03</span><strong>Issue Stock</strong><small>Store In-charge</small></div><div class="workflow-step"><span class="step-num">04</span><strong>Complete Work</strong><small>Photos required</small></div><div class="workflow-step"><span class="step-num">05</span><strong>Review & Checklist</strong><small>Supervisor → Engineer</small></div><div class="workflow-step"><span class="step-num">06</span><strong>JMR + Billing</strong><small>Separate pending tasks</small></div></div></div>
