@model CreateSupplierViewModel
@{ ViewData["Title"] = "Add supplier"; }
<div class="section-head"><div><h1>Add supplier</h1><p class="subheading">Supplier records are shared reference data across assigned projects.</p></div><a asp-action="Index" class="button button-light">Cancel</a></div><div class="card"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label>Name *</label><input asp-for="Name"/></div><div class="field"><label>Supplier code</label><input asp-for="Code"/></div><div class="field"><label>Contact person</label><input asp-for="ContactPerson"/></div><div class="field"><label>Phone</label><input asp-for="Phone"/></div><div class="field"><label>Email</label><input asp-for="Email"/></div><div class="field"><label>GSTIN</label><input asp-for="GSTIN"/></div><div class="field wide"><label>Address</label><textarea asp-for="Address"></textarea></div></div><div class="form-actions"><button class="button button-primary" type="submit">Save supplier</button></div></form></div>
