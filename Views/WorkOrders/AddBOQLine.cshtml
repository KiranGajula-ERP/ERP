@model CreateBOQLineViewModel
@{ViewData["Title"]="Add BOQ Line";var order=ViewBag.Order as WorkOrder;var items=ViewBag.Items as List<Item>??[];}
<div class="section-head"><div><h1>Add BOQ line</h1><p class="subheading">@order?.Number · @order?.Title</p></div><a class="button button-light" asp-action="Details" asp-route-id="@Model.WorkOrderId">Cancel</a></div>
<div class="card"><form asp-action="AddBOQLine" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><input type="hidden" asp-for="WorkOrderId"/><div class="form-grid"><div class="field wide"><label asp-for="ItemId">Material *</label><select asp-for="ItemId">@foreach(var i in items){<option value="@i.Id">@i.Code — @i.Name (@i.Unit?.Code)</option>}</select></div><div class="field"><label asp-for="Quantity">BOQ quantity *</label><input asp-for="Quantity" type="number" min="0.0001" step="0.0001"/></div><div class="field"><label asp-for="Rate">Rate per unit (₹)</label><input asp-for="Rate" type="number" min="0" step="0.01"/></div></div><div class="form-actions"><button class="button button-primary" type="submit">Add BOQ line</button></div></form></div>
