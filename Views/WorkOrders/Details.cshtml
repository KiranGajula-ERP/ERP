@model WorkOrder
@{ ViewData["Title"]="Work Order Details";var lines=ViewBag.Lines as List<BOQLine>??[];decimal total=(decimal)ViewBag.TotalBOQ; }
<div class="section-head"><div><h1>@Model.Number</h1><p class="subheading">@Model.Project?.Name · @Model.Title</p></div><div class="btn-row"><a class="button button-light" asp-action="Index" asp-route-projectId="@Model.ProjectId">Back to Work Orders</a><a class="button button-primary" asp-action="AddBOQLine" asp-route-workOrderId="@Model.Id">+ Add BOQ line</a></div></div>
<div class="tiles"><div class="tile blue"><span class="label">Work Order value</span><span class="value">₹@Model.Value.ToString("N2")</span></div><div class="tile saffron"><span class="label">BOQ line value</span><span class="value">₹@total.ToString("N2")</span></div><div class="tile"><span class="label">BOQ lines</span><span class="value">@lines.Count</span></div></div>
<div class="card"><div class="table-wrap"><table><thead><tr><th>Item code</th><th>Material</th><th>Unit</th><th class="number">BOQ qty</th><th class="number">Rate</th><th class="number">Line value</th><th class="number">Completed qty</th><th class="number">Balance qty</th></tr></thead><tbody>@foreach(var l in lines){<tr><td>@l.Item?.Code</td><td><strong>@l.Item?.Name</strong></td><td>@l.Item?.Unit?.Code</td><td class="number">@l.Quantity.ToString("0.####")</td><td class="number">₹@l.Rate.ToString("N2")</td><td class="number">₹@(l.Quantity*l.Rate).ToString("N2")</td><td class="number">@l.CompletedQuantity.ToString("0.####")</td><td class="number">@(l.Quantity-l.CompletedQuantity).ToString("0.####")</td></tr>}</tbody></table></div>@if(!lines.Any()){<div class="empty-state">Add BOQ lines to connect material Indents and procurement to this work scope.</div>}</div>
