@model CreateWorkOrderViewModel
@{ ViewData["Title"] = "Create Work Order"; var project = ViewBag.Project as Project; }
<div class="section-head"><div><h1>Create Work Order</h1><p class="subheading">Project: @project?.Name</p></div><a class="button button-light" asp-action="Index" asp-route-projectId="@Model.ProjectId">Cancel</a></div>
<div class="card"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><input type="hidden" asp-for="ProjectId"/><div class="form-grid"><div class="field"><label asp-for="Number">Work Order number *</label><input asp-for="Number"/><span asp-validation-for="Number" class="validation-message"></span></div><div class="field"><label asp-for="OrderDate">Work Order date</label><input asp-for="OrderDate" type="date"/></div><div class="field wide"><label asp-for="Title">Work scope / title *</label><input asp-for="Title"/><span asp-validation-for="Title" class="validation-message"></span></div><div class="field"><label asp-for="Value">Work Order value (₹)</label><input asp-for="Value" type="number" min="0" step="0.01"/></div></div><div class="form-actions"><button class="button button-primary" type="submit">Create Work Order</button></div></form></div>
