@model List<WorkOrder>
@{ ViewData["Title"] = "Work Orders & BOQ"; var project = ViewBag.Project as Project; }
<div class="section-head"><div><h1>Work Orders & BOQ</h1><p class="subheading">@project?.Name · Approved work scopes and planned quantities for material control.</p></div><a class="button button-primary" asp-action="Create" asp-route-projectId="@project?.Id">+ Create Work Order</a></div>
<div class="card"><div class="table-wrap"><table><thead><tr><th>Work Order</th><th>Title</th><th>Date</th><th class="number">Contract value</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var w in Model){<tr><td><strong>@w.Number</strong></td><td>@w.Title</td><td>@w.OrderDate?.ToString("dd-MMM-yyyy")</td><td class="number">₹@w.Value.ToString("N2")</td><td><span class="tag tag-green">@w.Status</span></td><td><a class="button button-light button-sm" asp-action="Details" asp-route-id="@w.Id">Open / BOQ</a></td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="empty-state">No Work Orders yet. Create one, then add BOQ lines for project materials.</div>}</div>
