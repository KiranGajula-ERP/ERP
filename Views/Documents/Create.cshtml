@model CreateDocumentViewModel
@{ ViewData["Title"] = "Link document"; var projects = ViewBag.Projects as List<Project> ?? []; }
<div class="section-head"><div><h1>Link physical or system document</h1><p class="subheading">Create a searchable reference and optionally attach a signed scan or generated file.</p></div><a asp-action="Index" class="button button-light">Cancel</a></div><div class="card"><form asp-action="Create" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label asp-for="DocumentType">Document type *</label><select asp-for="DocumentType">@foreach(var t in new[]{"MR","RFQ","PO","Supplier Invoice","DC","GRN/MRN","Indent","Issue Slip","Checklist","Client Approval","JMR","RA Bill","Bank Statement","Photo Evidence","Other"}){<option>@t</option>}</select></div><div class="field"><label asp-for="ReferenceNumber">Reference number *</label><input asp-for="ReferenceNumber"/></div><div class="field"><label asp-for="ProjectId">Project</label><select asp-for="ProjectId"><option value="">Company-wide / central store</option>@foreach(var p in projects){<option value="@p.Id">@p.Name</option>}</select></div><div class="field"><label asp-for="Title">Title / description</label><input asp-for="Title"/></div><div class="field"><label asp-for="RelatedEntityType">Linked record type</label><input asp-for="RelatedEntityType" placeholder="Indent, PO, GRN, RA Bill…"/></div><div class="field"><label asp-for="RelatedEntityId">Linked record ID (optional)</label><input asp-for="RelatedEntityId" type="number" min="1"/></div><div class="field wide"><label asp-for="File">Attachment (optional)</label><input asp-for="File" type="file" accept=".pdf,.jpg,.jpeg,.png,.webp,.docx,.xlsx"/><small class="muted">PDF, images, DOCX or XLSX, maximum 20 MB.</small></div><div class="field wide"><label class="checkline"><input asp-for="IsPhysicalOrSigned"/> This is a physical / signed document copy</label></div><div class="field wide"><label asp-for="Notes">Notes</label><textarea asp-for="Notes"></textarea></div></div><div class="form-actions"><button class="button button-primary" type="submit">Save document link</button></div></form></div>
