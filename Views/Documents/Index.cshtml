@model List<DocumentRecord>
@{ ViewData["Title"] = "Document register"; var projects = ViewBag.Projects as List<Project> ?? []; int? projectId = ViewBag.ProjectId as int?; var q = ViewBag.Query as string ?? ""; }
<div class="section-head"><div><h1>Document register</h1><p class="subheading">Link system-created records with scans, signed copies, and supporting evidence.</p></div><a asp-action="Create" asp-route-projectId="@projectId" class="button button-primary">+ Link document</a></div>
<div class="card"><form method="get" class="filters"><div class="field"><label>Project</label><select name="projectId"><option value="">All assigned projects</option>@foreach(var p in projects){<option value="@p.Id" selected="@(projectId==p.Id)">@p.Name</option>}</select></div><div class="field"><label>Reference / title / type</label><input name="q" value="@q" placeholder="PO, GRN, DC, invoice, JMR…"/></div><button class="button button-primary" type="submit">Search</button><a class="button button-light" asp-action="Index">Clear</a></form><div class="table-wrap"><table><thead><tr><th>Document reference</th><th>Type</th><th>Project</th><th>Linked record</th><th>Physical/signed</th><th>File</th><th>Created</th></tr></thead><tbody>@foreach(var d in Model){<tr><td><strong>@d.ReferenceNumber</strong><div class="muted small">@d.Title</div></td><td>@d.DocumentType</td><td>@(d.Project?.Name ?? "Company-wide")</td><td>@d.RelatedEntityType @if(d.RelatedEntityId.HasValue){<span>#@d.RelatedEntityId</span>}</td><td>@(d.IsPhysicalOrSigned?"Yes":"System record")</td><td>@if(d.StoredPath is not null){<a class="button button-light button-sm" asp-action="Open" asp-route-id="@d.Id">Open attachment</a>}else{<span class="muted small">Reference only</span>}</td><td>@d.CreatedAtUtc.ToLocalTime().ToString("dd-MMM-yyyy")</td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="empty-state"><strong>No documents found</strong>Create a document record or search for another reference.</div>}</div>
