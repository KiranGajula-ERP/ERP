@model VerifyGrnViewModel
@{ ViewData["Title"] = "Verify GRN"; var grn = ViewBag.GRN as GoodsReceiptNote; var line = ViewBag.Line as GoodsReceiptLine; }
<div class="section-head"><div><h1>Verify GRN @grn?.Number</h1><p class="subheading">Enter the accepted quantity after physical verification. Discrepancies require remarks.</p></div><a asp-action="Index" class="button button-light">Cancel</a></div><div class="card"><div class="detail-grid"><div class="detail-item"><small>GRN Status</small><strong>@grn?.Status</strong></div><div class="detail-item"><small>Material</small><strong>@line?.Item?.Name</strong></div><div class="detail-item"><small>Expected quantity</small><strong>@line?.ExpectedQuantity.ToString("0.####")</strong></div><div class="detail-item"><small>Received quantity</small><strong>@line?.ReceivedQuantity.ToString("0.####")</strong></div></div><form asp-action="VerifyGRN" method="post" style="margin-top:20px"><input type="hidden" asp-for="Id"/><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label asp-for="AcceptedQuantity">Accepted quantity *</label><input asp-for="AcceptedQuantity" type="number" min="0" max="@line?.ReceivedQuantity" step="0.0001"/><span asp-validation-for="AcceptedQuantity" class="validation-message"></span></div><div class="field wide"><label asp-for="Remarks">Discrepancy / verification remarks</label><textarea asp-for="Remarks" placeholder="Required when expected, received and accepted quantities differ"></textarea><span asp-validation-for="Remarks" class="validation-message"></span></div></div><div class="form-actions"><button type="submit" class="button button-primary">Confirm verification and post accepted stock</button></div></form></div>
