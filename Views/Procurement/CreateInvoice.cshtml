@model CreateInvoiceViewModel
@{ ViewData["Title"]="Supplier Invoice";var projects=ViewBag.Projects as List<Project>??[];var suppliers=ViewBag.Suppliers as List<Supplier>??[];var pos=ViewBag.POs as List<PurchaseOrder>??[]; }
<div class="section-head"><div><h1>Record Supplier Invoice</h1><p class="subheading">Link the supplier's invoice to its project and Purchase Order where applicable.</p></div><a class="button button-light" asp-action="Index">Cancel</a></div><div class="card"><form asp-action="CreateInvoice" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label>Project *</label><select asp-for="ProjectId">@foreach(var x in projects){<option value="@x.Id">@x.Name</option>}</select></div><div class="field"><label>Supplier *</label><select asp-for="SupplierId">@foreach(var x in suppliers){<option value="@x.Id">@x.Name</option>}</select></div><div class="field"><label>Invoice number *</label><input asp-for="InvoiceNumber"/><span asp-validation-for="InvoiceNumber" class="validation-message"></span></div><div class="field"><label>Invoice date</label><input asp-for="InvoiceDate" type="date"/></div><div class="field"><label>Purchase Order</label><select asp-for="PurchaseOrderId"><option value="">None</option>@foreach(var x in pos){<option value="@x.Id">@x.Number</option>}</select></div><div class="field"><label>Total invoice value (₹)</label><input asp-for="TotalValue" type="number" min="0" step="0.01"/></div></div><div class="form-actions"><button class="button button-primary" type="submit">Save supplier invoice</button></div></form></div>
