@model CreateSupplierQuotationViewModel
@{ ViewData["Title"]="Record Supplier Quotation";var rfqs=ViewBag.RFQs as List<RFQ>??[];var suppliers=ViewBag.Suppliers as List<Supplier>??[]; }
<div class="section-head"><div><h1>Record Supplier Quotation</h1><p class="subheading">Capture supplier offers so the purchase team can compare commercial values before creating a PO.</p></div><a class="button button-light" asp-action="Index">Cancel</a></div><div class="card"><form asp-action="CreateQuotation" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field wide"><label>RFQ *</label><select asp-for="RFQId">@foreach(var x in rfqs){<option value="@x.Id">@x.Number — @x.Project?.Name</option>}</select><span asp-validation-for="RFQId" class="validation-message"></span></div><div class="field"><label>Supplier *</label><select asp-for="SupplierId">@foreach(var x in suppliers){<option value="@x.Id">@x.Name</option>}</select></div><div class="field"><label>Quoted total (₹)</label><input asp-for="TotalValue" type="number" min="0" step="0.01"/></div><div class="field"><label>Quotation date</label><input asp-for="QuotationDate" type="date"/></div><div class="field"><label>Valid until</label><input asp-for="ValidUntil" type="date"/></div><div class="field wide"><label>Commercial notes</label><textarea asp-for="Notes"></textarea></div></div><div class="form-actions"><button class="button button-primary" type="submit">Save quotation</button></div></form></div>
