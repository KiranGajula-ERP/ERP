@model CreateDeliveryChallanViewModel
@{ ViewData["Title"]="Delivery Challan";var projects=ViewBag.Projects as List<Project>??[];var suppliers=ViewBag.Suppliers as List<Supplier>??[];var pos=ViewBag.POs as List<PurchaseOrder>??[]; }
<div class="section-head"><div><h1>Record Delivery Challan</h1><p class="subheading">Record the physical delivery reference. The DC alone does not increase stock.</p></div><a class="button button-light" asp-action="Index">Cancel</a></div><div class="card"><form asp-action="CreateDC" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label>Project *</label><select asp-for="ProjectId">@foreach(var x in projects){<option value="@x.Id">@x.Name</option>}</select></div><div class="field"><label>Supplier *</label><select asp-for="SupplierId">@foreach(var x in suppliers){<option value="@x.Id">@x.Name</option>}</select></div><div class="field"><label>DC number *</label><input asp-for="Number"/><span asp-validation-for="Number" class="validation-message"></span></div><div class="field"><label>DC date</label><input asp-for="ChallanDate" type="date"/></div><div class="field wide"><label>Purchase Order</label><select asp-for="PurchaseOrderId"><option value="">None</option>@foreach(var x in pos){<option value="@x.Id">@x.Number</option>}</select></div></div><div class="form-actions"><button class="button button-primary" type="submit">Save delivery challan</button></div></form></div>
