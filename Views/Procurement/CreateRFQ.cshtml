@model CreateRFQViewModel
@{ ViewData["Title"] = "Create RFQ"; var projects = ViewBag.Projects as List<Project> ?? []; var mrs = ViewBag.MRs as List<MaterialRequisition> ?? []; }
<div class="section-head"><div><h1>Create Request for Quotation</h1><p class="subheading">Record an RFQ and its planned supplier-response date.</p></div><a asp-action="Index" class="button button-light">Cancel</a></div><div class="card"><form asp-action="CreateRFQ" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label>Project *</label><select asp-for="ProjectId">@foreach(var p in projects){<option value="@p.Id">@p.Name</option>}</select></div><div class="field"><label>RFQ number *</label><input asp-for="Number"/></div><div class="field"><label>Linked MR</label><select asp-for="MaterialRequisitionId"><option value="">None</option>@foreach(var m in mrs){<option value="@m.Id">@m.Number — @m.Project?.Name</option>}</select></div><div class="field"><label>Issue date</label><input asp-for="CreatedDate" type="date"/></div><div class="field"><label>Quotation due date</label><input asp-for="DueDate" type="date"/></div></div><div class="form-actions"><button class="button button-primary" type="submit">Create RFQ</button></div></form></div>
