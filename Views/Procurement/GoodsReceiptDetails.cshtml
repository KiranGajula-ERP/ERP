@model GoodsReceiptNote
@using AuditFlow.Web.Models
@{ ViewData["Title"] = "Goods Receipt Note"; var docs = ViewBag.LinkedDocuments as List<DocumentRecord> ?? []; var canVerify = Model.Status == "PendingVerification" && (User.IsInRole(AppRoles.SystemAdministrator)||User.IsInRole(AppRoles.Management)||User.IsInRole(AppRoles.PurchaseTeam)||User.IsInRole(AppRoles.StoreInCharge)); }
<div class="section-head"><div><h1>GRN @Model.Number</h1><p class="subheading">Receipt verification and accepted quantities. Only accepted quantities are posted to stock.</p></div><div class="btn-row"><a asp-action="Index" class="button button-light">Back to Purchase & Receipt</a>@if(canVerify){<a asp-action="VerifyGRN" asp-route-id="@Model.Id" class="button button-primary">Verify receipt</a>}</div></div>
<div class="tiles"><div class="tile blue"><span class="label">Project / Allocation</span><span class="value">@(Model.Project?.Name ?? "Central Company Store")</span></div><div class="tile"><span class="label">Store</span><span class="value">@Model.StoreLocation?.Name</span></div><div class="tile saffron"><span class="label">Status</span><span class="value">@Model.Status</span></div><div class="tile"><span class="label">Receipt date</span><span class="value">@Model.ReceiptDate.ToString("dd-MMM-yyyy")</span></div></div>
<div class="card"><h2>Document references</h2><div class="detail-grid"><div class="detail-item"><small>Purchase Order</small><strong>@(Model.PurchaseOrder?.Number ?? "—")</strong><small>@Model.PurchaseOrder?.Supplier?.Name</small></div><div class="detail-item"><small>Supplier Invoice</small><strong>@(Model.SupplierInvoice?.InvoiceNumber ?? "—")</strong><small>@Model.SupplierInvoice?.Supplier?.Name</small></div><div class="detail-item"><small>Delivery Challan</small><strong>@(Model.DeliveryChallan?.Number ?? "—")</strong><small>@Model.DeliveryChallan?.Supplier?.Name</small></div><div class="detail-item"><small>Created by</small><strong>@Model.CreatedBy?.DisplayName</strong></div><div class="detail-item"><small>Verified by</small><strong>@(Model.VerifiedBy?.DisplayName ?? "Pending")</strong></div><div class="detail-item"><small>Discrepancy / remarks</small><strong>@(string.IsNullOrWhiteSpace(Model.DiscrepancyNotes) ? "—" : Model.DiscrepancyNotes)</strong></div></div><p class="muted small">Click the reference links from the appropriate register to open the linked PO, invoice or DC details.</p></div>
<div class="card"><h2>Receipt lines</h2><div class="table-wrap"><table><thead><tr><th>Material</th><th>Unit</th><th class="number">Expected qty</th><th class="number">Received qty</th><th class="number">Accepted qty</th><th class="number">Unit cost</th><th class="number">Accepted value</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td><strong>@line.Item?.Name</strong><div class="muted small">@line.Item?.Code</div></td><td>@line.Item?.Unit?.Name</td><td class="number">@line.ExpectedQuantity.ToString("0.####")</td><td class="number">@line.ReceivedQuantity.ToString("0.####")</td><td class="number">@line.AcceptedQuantity.ToString("0.####")</td><td class="number">₹@line.UnitCost.ToString("N2")</td><td class="number">₹@((line.AcceptedQuantity * line.UnitCost).ToString("N2"))</td></tr>}</tbody></table></div></div>
<div class="card"><div class="card-header"><h2>Physical / signed documents</h2><a class="button button-light button-sm" asp-controller="Documents" asp-action="Create" asp-route-projectId="@Model.ProjectId">Link document</a></div><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Type</th><th>Title</th><th>Attachment</th></tr></thead><tbody>@foreach(var d in docs){<tr><td>@d.ReferenceNumber</td><td>@d.DocumentType</td><td>@d.Title</td><td>@if(d.StoredPath is not null){<a asp-controller="Documents" asp-action="Open" asp-route-id="@d.Id" class="button button-light button-sm">Open attachment</a>}else{<span class="muted small">Reference only</span>}</td></tr>}</tbody></table></div>@if(!docs.Any()){<div class="empty-state">No signed copy or supporting document linked.</div>}</div>
