@model RFQ
@{ ViewData["Title"]="Quotation Comparison";var rows=ViewBag.Quotations as List<SupplierQuotation>??[]; }
<div class="section-head"><div><h1>Quotation comparison · @Model.Number</h1><p class="subheading">@Model.Project?.Name · Compare received supplier values and validity before choosing a supplier.</p></div><div class="btn-row"><a class="button button-light" asp-action="Index">Purchase & Receipt</a><a class="button button-primary" asp-action="CreateQuotation" asp-route-rfqId="@Model.Id">+ Add quotation</a></div></div><div class="tiles"><div class="tile blue"><span class="label">RFQ status</span><span class="value">@Model.Status</span></div><div class="tile"><span class="label">Quotes received</span><span class="value">@rows.Count</span></div><div class="tile green"><span class="label">Lowest quoted value</span><span class="value">@(rows.Count>0?"₹"+rows.Min(x=>x.TotalValue).ToString("N2"):"—")</span></div></div><div class="card"><div class="table-wrap"><table><thead><tr><th>Supplier</th><th class="number">Quoted total</th><th>Date</th><th>Valid until</th><th>Notes</th><th>Commercial status</th></tr></thead><tbody>@foreach(var x in rows){<tr><td><strong>@x.Supplier?.Name</strong></td><td class="number">₹@x.TotalValue.ToString("N2")</td><td>@x.QuotationDate.ToString("dd-MMM-yyyy")</td><td>@x.ValidUntil?.ToString("dd-MMM-yyyy")</td><td>@x.Notes</td><td><span class="tag @(x.TotalValue==rows.Min(r=>r.TotalValue)?"tag-green":"tag")">@(x.TotalValue==rows.Min(r=>r.TotalValue)?"Lowest price":"Received")</span></td></tr>}</tbody></table></div>@if(!rows.Any()){<div class="empty-state">No supplier quotations have been recorded for this RFQ.</div>}</div><div class="alert alert-info">Lowest price is a comparison signal only. Confirm specification compliance, delivery, tax, warranty and approved commercial terms before finalizing the supplier.</div>
