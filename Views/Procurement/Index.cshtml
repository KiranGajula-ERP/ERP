@using AuditFlow.Web.Models
@{ ViewData["Title"] = "Purchase & Receipt"; var pos = ViewBag.POs as List<PurchaseOrder> ?? []; var grns = ViewBag.GRN as List<GoodsReceiptNote> ?? []; bool canPurchase = User.IsInRole(AppRoles.SystemAdministrator)||User.IsInRole(AppRoles.Management)||User.IsInRole(AppRoles.PurchaseTeam); }
<div class="section-head"><div><h1>Purchase & Receipt</h1><p class="subheading">Procurement documents, supplier orders and verified stock receipts.</p></div>@if(canPurchase){<div class="btn-row"><a class="button button-light" asp-action="CreateMR">+ Material Requisition</a><a class="button button-light" asp-action="CreateRFQ">+ RFQ</a><a class="button button-light" asp-action="CreateQuotation">+ Supplier quotation</a><a class="button button-primary" asp-action="CreatePO">+ Purchase Order</a><a class="button button-light" asp-action="CreateInvoice">+ Invoice</a><a class="button button-light" asp-action="CreateDC">+ DC</a><a class="button button-light" asp-action="CreateGRN">+ GRN</a></div>}else{<a class="button button-primary" asp-action="CreateGRN">+ Record GRN</a>}</div>
<div class="tiles"><div class="tile saffron"><span class="label">Material Requisitions</span><span class="value">@ViewBag.MRCount</span></div><div class="tile blue"><span class="label">RFQs</span><span class="value">@ViewBag.RFQCount</span></div><div class="tile"><span class="label">Purchase Orders</span><span class="value">@ViewBag.POCount</span></div><div class="tile red"><span class="label">GRNs awaiting verification</span><span class="value">@ViewBag.PendingGRN</span></div></div>
<div class="split-grid"><div class="card"><div class="card-header"><h2>Purchase Orders</h2><a asp-action="CreatePO" class="button button-light button-sm">New PO</a></div><div class="table-wrap"><table><thead><tr><th>PO number</th><th>Project</th><th>Supplier</th><th class="number">Value</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var p in pos){<tr><td><strong>@p.Number</strong><div class="muted small">@p.OrderDate.ToString("dd-MMM-yyyy")</div></td><td>@p.Project?.Name</td><td>@p.Supplier?.Name</td><td class="number">₹@p.TotalValue.ToString("N2")</td><td><span class="tag @(p.IsApproved?"tag-green":"tag-yellow")">@p.Status</span></td><td>@if(!p.IsApproved && canPurchase){<form asp-action="ApprovePO" method="post" class="inline-form"><input type="hidden" name="id" value="@p.Id"/><button type="submit" class="button button-primary button-sm">Approve</button></form>}</td></tr>}</tbody></table></div></div>
<div class="card"><div class="card-header"><h2>Goods Receipt Notes</h2><a asp-action="CreateGRN" class="button button-light button-sm">New GRN</a></div><div class="table-wrap"><table><thead><tr><th>GRN</th><th>Project</th><th>Date</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var g in grns){<tr><td><strong>@g.Number</strong></td><td>@g.Project?.Name</td><td>@g.ReceiptDate.ToString("dd-MMM-yyyy")</td><td><span class="tag @(g.Status=="Verified"?"tag-green":g.Status=="PendingVerification"?"tag-yellow":"tag-red")">@g.Status</span></td><td>@if(g.Status=="PendingVerification"){<a class="button button-primary button-sm" asp-action="VerifyGRN" asp-route-id="@g.Id">Verify</a>}</td></tr>}</tbody></table></div></div></div>
<div class="card"><h2>Procurement sequence</h2><div class="workflow-steps"><div class="workflow-step"><span class="step-num">01</span><strong>MR</strong><small>Demand against BOQ / work order</small></div><div class="workflow-step"><span class="step-num">02</span><strong>RFQ & Quotations</strong><small>Compare supplier offers</small></div><div class="workflow-step"><span class="step-num">03</span><strong>PO</strong><small>Authorize order</small></div><div class="workflow-step"><span class="step-num">04</span><strong>Invoice + DC</strong><small>Supplier documentation</small></div><div class="workflow-step"><span class="step-num">05</span><strong>GRN verification</strong><small>Discrepancy requires remarks</small></div><div class="workflow-step"><span class="step-num">06</span><strong>Stock ledger</strong><small>Only accepted quantity posts</small></div></div><p class="muted small" style="margin-top:12px">This beta captures core reference fields. Advanced multi-line RFQ comparison and PO line schedules should be expanded before production purchasing.</p></div>

@{ var rfqs = ViewBag.RFQs as List<RFQ> ?? []; var invoices = ViewBag.Invoices as List<SupplierInvoice> ?? []; var dcs = ViewBag.DCs as List<DeliveryChallan> ?? []; var payments = ViewBag.SupplierPayments as List<SupplierPayment> ?? []; }
<div class="split-grid"><div class="card"><div class="card-header"><h2>RFQs & quotations</h2><a class="button button-light button-sm" asp-action="CreateRFQ">New RFQ</a></div><div class="table-wrap"><table><thead><tr><th>RFQ</th><th>Project</th><th>Date</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var r in rfqs){<tr><td><strong>@r.Number</strong></td><td>@r.Project?.Name</td><td>@r.CreatedDate.ToString("dd-MMM-yyyy")</td><td>@r.Status</td><td><div class="btn-row"><a class="button button-light button-sm" asp-action="CompareRFQ" asp-route-id="@r.Id">Compare</a><a class="button button-light button-sm" asp-action="CreateQuotation" asp-route-rfqId="@r.Id">Add quote</a></div></td></tr>}</tbody></table></div></div><div class="card"><div class="card-header"><h2>Supplier invoices</h2><a class="button button-light button-sm" asp-action="CreateInvoice">Record invoice</a></div><div class="table-wrap"><table><thead><tr><th>Invoice</th><th>Supplier</th><th>Project</th><th class="number">Value</th></tr></thead><tbody>@foreach(var i in invoices){<tr><td>@i.InvoiceNumber<div class="muted small">@i.InvoiceDate.ToString("dd-MMM-yyyy")</div></td><td>@i.Supplier?.Name</td><td>@i.Project?.Name</td><td class="number">₹@i.TotalValue.ToString("N2")</td></tr>}</tbody></table></div></div></div>
<div class="split-grid"><div class="card"><div class="card-header"><h2>Delivery challans</h2><a class="button button-light button-sm" asp-action="CreateDC">Record DC</a></div><div class="table-wrap"><table><thead><tr><th>DC number</th><th>Supplier</th><th>Project</th><th>Date</th></tr></thead><tbody>@foreach(var d in dcs){<tr><td>@d.Number</td><td>@d.Supplier?.Name</td><td>@d.Project?.Name</td><td>@d.ChallanDate.ToString("dd-MMM-yyyy")</td></tr>}</tbody></table></div></div><div class="card"><div class="card-header"><h2>Supplier payments</h2><a class="button button-light button-sm" asp-action="SupplierPayment">Record payment</a></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>Invoice</th><th class="number">Paid</th><th>Reference</th></tr></thead><tbody>@foreach(var d in payments){<tr><td>@d.PaymentDate.ToString("dd-MMM-yyyy")</td><td>@d.SupplierInvoice?.InvoiceNumber</td><td class="number">₹@d.Amount.ToString("N2")</td><td>@d.Reference</td></tr>}</tbody></table></div></div></div>
