@model CreateRequisitionViewModel
@{ ViewData["Title"] = "Create Material Requisition"; var projects = ViewBag.Projects as List<Project> ?? []; var items = ViewBag.Items as List<Item> ?? []; }
<div class="section-head"><div><h1>Create Material Requisition</h1><p class="subheading">Raise an internal material demand against a project and (optionally) a work order.</p></div><a asp-action="Index" class="button button-light">Cancel</a></div><div class="card"><form asp-action="CreateMR" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label>Project *</label><select asp-for="ProjectId">@foreach(var p in projects){<option value="@p.Id">@p.Name</option>}</select></div><div class="field"><label>MR number *</label><input asp-for="Number"/></div><div class="field wide"><label>Material *</label><select asp-for="ItemId">@foreach(var i in items){<option value="@i.Id">@i.Code — @i.Name (@i.Unit?.Code)</option>}</select></div><div class="field"><label>Quantity *</label><input asp-for="Quantity" type="number" min="0.0001" step="0.0001"/></div><div class="field"><label>Estimated unit rate</label><input asp-for="EstimatedRate" type="number" min="0" step="0.01"/></div><div class="field wide"><label>Purpose / work order reference</label><textarea asp-for="Purpose"></textarea></div></div><div class="form-actions"><button class="button button-primary" type="submit">Save Material Requisition</button></div></form></div>
