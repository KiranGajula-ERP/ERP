@model CreatePurchaseOrderViewModel
@{ ViewData["Title"] = "Create Purchase Order"; var projects = ViewBag.Projects as List<Project> ?? []; var suppliers = ViewBag.Suppliers as List<Supplier> ?? []; var rfqs = ViewBag.RFQs as List<RFQ> ?? []; }
<div class="section-head"><div><h1>Create Purchase Order</h1><p class="subheading">PO must be approved before it is treated as an authorized order.</p></div><a asp-action="Index" class="button button-light">Cancel</a></div><div class="card"><form asp-action="CreatePO" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label>Project *</label><select asp-for="ProjectId">@foreach(var p in projects){<option value="@p.Id">@p.Name</option>}</select></div><div class="field"><label>Supplier *</label><select asp-for="SupplierId">@foreach(var s in suppliers){<option value="@s.Id">@s.Name</option>}</select></div><div class="field"><label>PO number *</label><input asp-for="Number"/></div><div class="field"><label>Order date</label><input asp-for="OrderDate" type="date"/></div><div class="field"><label>Linked RFQ</label><select asp-for="RFQId"><option value="">None</option>@foreach(var r in rfqs){<option value="@r.Id">@r.Number — @r.Project?.Name</option>}</select></div><div class="field"><label>Total value (₹)</label><input asp-for="TotalValue" type="number" min="0" step="0.01"/></div></div><div class="alert alert-info" style="margin-top:16px">This initial screen captures the PO header and total value. Detailed line items, tax and delivery terms should be captured in the next procurement hardening stage before formal use.</div><div class="form-actions"><button class="button button-primary" type="submit">Save PO (pending approval)</button></div></form></div>
