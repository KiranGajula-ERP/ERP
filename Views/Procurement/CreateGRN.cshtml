@model CreateGrnViewModel
@using AuditFlow.Web.Models
@{ ViewData["Title"] = "Create GRN"; var projects = ViewBag.Projects as List<Project> ?? []; var items = ViewBag.Items as List<Item> ?? []; var stores = ViewBag.Stores as List<StoreLocation> ?? []; var pos = ViewBag.POs as List<PurchaseOrder> ?? []; var invoices = ViewBag.Invoices as List<SupplierInvoice> ?? []; var dcs = ViewBag.DCs as List<DeliveryChallan> ?? []; var canCentral = User.IsInRole(AppRoles.SystemAdministrator)||User.IsInRole(AppRoles.Management)||User.IsInRole(AppRoles.PurchaseTeam); }
<div class="section-head"><div><h1>Record Goods Receipt Note</h1><p class="subheading">A GRN is posted to inventory only after authorized verification. Central-store receipts remain company stock until transferred to a project.</p></div><a asp-action="Index" class="button button-light">Cancel</a></div><div class="card"><form asp-action="CreateGRN" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label>Project allocation</label><select asp-for="ProjectId"><option value="">@(canCentral?"Central company store receipt":"Select project")</option>@foreach(var p in projects){<option value="@p.Id">@p.Name</option>}</select><small class="muted">Leave blank only when receiving directly into the central company store.</small></div><div class="field"><label>Receiving store *</label><select asp-for="StoreLocationId">@foreach(var s in stores){<option value="@s.Id">@(s.IsCentralStore?"Central: ":"")@s.Name</option>}</select></div><div class="field"><label>GRN number *</label><input asp-for="Number"/><span asp-validation-for="Number" class="validation-message"></span></div><div class="field"><label>Receipt date</label><input asp-for="ReceiptDate" type="date"/></div><div class="field"><label>PO reference</label><select asp-for="PurchaseOrderId"><option value="">None</option>@foreach(var p in pos){<option value="@p.Id">@p.Number</option>}</select></div><div class="field"><label>Supplier invoice</label><select asp-for="SupplierInvoiceId"><option value="">None</option>@foreach(var i in invoices){<option value="@i.Id">@i.InvoiceNumber</option>}</select></div><div class="field"><label>Delivery challan</label><select asp-for="DeliveryChallanId"><option value="">None</option>@foreach(var d in dcs){<option value="@d.Id">@d.Number</option>}</select></div><div class="field wide"><label>Material *</label><select asp-for="ItemId">@foreach(var i in items){<option value="@i.Id">@i.Code — @i.Name (@i.Unit?.Code)</option>}</select></div><div class="field"><label>Expected quantity</label><input asp-for="ExpectedQuantity" type="number" min="0" step="0.0001"/></div><div class="field"><label>Quantity physically received</label><input asp-for="ReceivedQuantity" type="number" min="0" step="0.0001"/></div><div class="field"><label>Accepted quantity (entered at verification)</label><input asp-for="AcceptedQuantity" type="number" min="0" step="0.0001" value="0"/><small class="muted">The receipt is held pending verification; stock is not posted until an authorized person accepts it.</small></div><div class="field"><label>Unit cost (₹)</label><input asp-for="UnitCost" type="number" min="0" step="0.01"/></div></div><div class="form-actions"><button class="button button-primary" type="submit">Record GRN pending verification</button></div></form></div>
@section Scripts { <script>const proj=document.getElementById('ProjectId');const store=document.getElementById('StoreLocationId');proj?.addEventListener('change',()=>{if(!store)return;const selected=proj.value;for(const opt of store.options){const t=opt.text.toLowerCase();if(!selected)opt.hidden=!t.startsWith('central:');else opt.hidden=t.startsWith('central:');}const current=store.options[store.selectedIndex];if(current?.hidden){const first=[...store.options].find(o=>!o.hidden);if(first)store.value=first.value;}});proj?.dispatchEvent(new Event('change'));</script> }
