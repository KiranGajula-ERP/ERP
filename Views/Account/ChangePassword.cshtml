@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change password"; }
<div class="section-head"><div><h1>Change password</h1><p class="subheading">Use a unique password of at least 12 characters.</p></div><a asp-controller="Home" asp-action="Index" class="button button-light">Back to dashboard</a></div>
<div class="card form-card"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><form asp-action="ChangePassword" method="post"><div class="field"><label asp-for="CurrentPassword">Current password</label><input asp-for="CurrentPassword" autocomplete="current-password"/><span asp-validation-for="CurrentPassword" class="validation-message"></span></div><div class="field"><label asp-for="NewPassword">New password</label><input asp-for="NewPassword" autocomplete="new-password"/><span asp-validation-for="NewPassword" class="validation-message"></span></div><div class="field"><label asp-for="ConfirmPassword">Confirm new password</label><input asp-for="ConfirmPassword" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="validation-message"></span></div><button class="button button-primary" type="submit">Save new password</button></form></div>
