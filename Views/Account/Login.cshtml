@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<div class="login-wrap"><div class="login-card"><div class="login-brand"><span class="brand-mark">A</span><div><strong>AuditFlow</strong><div class="muted small">Contracting ERP · Local LAN</div></div></div><h1>Sign in to your workspace</h1><p class="kicker">Use the account created by your System Administrator.</p><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><form asp-action="Login" method="post"><input asp-for="ReturnUrl" type="hidden"/><div class="field"><label asp-for="UserName">Username</label><input asp-for="UserName" autocomplete="username" autofocus/><span asp-validation-for="UserName" class="validation-message"></span></div><div class="field" style="margin-top:14px"><label asp-for="Password">Password</label><input asp-for="Password" autocomplete="current-password"/><span asp-validation-for="Password" class="validation-message"></span></div><button type="submit" class="button button-primary" style="width:100%;margin-top:20px">Sign in</button></form><p class="muted small" style="margin-top:20px">For security, no default login is provided. The first administrator is created during setup.</p></div></div>
