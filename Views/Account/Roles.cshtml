@{ ViewData["Title"] = "Switch role"; var roles = ViewBag.Roles as List<RoleChoice> ?? []; }
<div class="section-head"><div><h1>Switch role</h1><p class="subheading">A user can use different roles on different projects. Select the role you need for this session.</p></div><a asp-controller="Home" asp-action="Index" class="button button-light">Back to dashboard</a></div>
<div class="card"><h2>Available roles</h2><div class="table-wrap"><table><thead><tr><th>Role</th><th>Session</th><th></th></tr></thead><tbody>@foreach (var r in roles){<tr><td><strong>@r.Label</strong><div class="muted small">@r.Role</div></td><td>@(r.Role == (string)ViewBag.CurrentRole ? "Current role" : "Available")</td><td><form asp-action="SwitchRole" method="post"><input type="hidden" name="role" value="@r.Role"/><button class="button @(r.Role == (string)ViewBag.CurrentRole ? "button-light" : "button-primary") button-sm" type="submit">@(r.Role == (string)ViewBag.CurrentRole ? "Current" : "Switch")</button></form></td></tr>}</tbody></table></div></div>
