@model AssignUserViewModel
@{ ViewData["Title"] = "Project assignments"; var users = ViewBag.Users as List<AppUser> ?? []; var projects = ViewBag.Projects as List<Project> ?? []; var towers = ViewBag.Towers as List<Tower> ?? []; var roles = ViewBag.Roles as string[] ?? []; var assignments = ViewBag.Assignments as List<UserProjectAssignment> ?? []; }
<div class="section-head"><div><h1>Project & tower assignments</h1><p class="subheading">Assign the user a role on each project. Tower scope narrows visibility and task responsibility.</p></div><a asp-action="Index" class="button button-light">Back to users</a></div>
<div class="card"><h2>Add assignment</h2><form asp-action="Assign" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label asp-for="UserId">User *</label><select asp-for="UserId">@foreach(var u in users){<option value="@u.Id">@u.DisplayName (@u.UserName)</option>}</select></div><div class="field"><label asp-for="Role">Role *</label><select asp-for="Role">@foreach(var r in roles){<option value="@r">@AppRoles.Label(r)</option>}</select></div><div class="field"><label asp-for="ProjectId">Project *</label><select asp-for="ProjectId">@foreach(var p in projects){<option value="@p.Id">@p.Name</option>}</select></div><div class="field"><label asp-for="TowerId">Tower (optional)</label><select asp-for="TowerId"><option value="">Project-wide</option>@foreach(var t in towers){<option value="@t.Id">@t.Project?.Name — @t.Name</option>}</select></div></div><div class="form-actions"><button type="submit" class="button button-primary">Save assignment</button></div></form></div>
<div class="card"><h2>Active assignments</h2><div class="table-wrap"><table><thead><tr><th>User</th><th>Project</th><th>Tower</th><th>Role</th><th></th></tr></thead><tbody>@foreach(var a in assignments){<tr><td>@a.User?.DisplayName</td><td>@a.Project?.Name</td><td>@(a.Tower?.Name ?? "All towers")</td><td>@AppRoles.Label(a.Role)</td><td><form asp-action="DeactivateAssignment" method="post" class="inline-form"><input type="hidden" name="id" value="@a.Id"/><button type="submit" class="button button-danger button-sm" data-confirm="Deactivate this assignment?">Deactivate</button></form></td></tr>}</tbody></table></div></div>
