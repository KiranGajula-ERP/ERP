@model CreateUserViewModel
@{ ViewData["Title"] = "Create user"; var projects = ViewBag.Projects as List<Project> ?? []; var towers = ViewBag.Towers as List<Tower> ?? []; var roles = ViewBag.Roles as string[] ?? []; }
<div class="section-head"><div><h1>Create user</h1><p class="subheading">Use a unique username and a strong initial password.</p></div><a asp-action="Index" class="button button-light">Cancel</a></div>
<div class="card"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label asp-for="DisplayName">Display name *</label><input asp-for="DisplayName"/><span asp-validation-for="DisplayName" class="validation-message"></span></div><div class="field"><label asp-for="UserName">Username *</label><input asp-for="UserName" autocomplete="off"/><span asp-validation-for="UserName" class="validation-message"></span></div><div class="field"><label asp-for="Email">Email</label><input asp-for="Email" type="email"/></div><div class="field"><label asp-for="Password">Temporary password *</label><input asp-for="Password" type="password" autocomplete="new-password"/><span asp-validation-for="Password" class="validation-message"></span><small class="muted">At least 12 characters.</small></div><div class="field"><label asp-for="Role">Primary role *</label><select asp-for="Role">@foreach(var r in roles){<option value="@r">@AppRoles.Label(r)</option>}</select></div><div class="field"><label asp-for="ProjectId">Initial project assignment (optional)</label><select asp-for="ProjectId"><option value="">No project</option>@foreach(var p in projects){<option value="@p.Id">@p.Name</option>}</select></div><div class="field wide"><label asp-for="TowerId">Tower scope (optional; blank means project-level assignment)</label><select asp-for="TowerId"><option value="">All towers / project scope</option>@foreach(var t in towers){<option value="@t.Id">@t.Project?.Name — @t.Name</option>}</select></div></div><div class="form-actions"><button class="button button-primary" type="submit">Create user</button><a asp-action="Assign" class="button button-light">Add more role assignments later</a></div></form></div>
