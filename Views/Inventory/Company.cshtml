@model List<AuditFlow.Web.Services.StockBalance>
@{ ViewData["Title"] = "Central Store Stock"; string q = ViewBag.Query as string ?? ""; int page = (int)ViewBag.Page; int pages = (int)ViewBag.TotalPages; var store = ViewBag.CentralStore as AuditFlow.Web.Models.StoreLocation; }
<div class="section-head"><div><h1>Central Store Stock</h1><p class="subheading">Company-owned stock held centrally. Transfers into project stores are tracked separately and are not double-counted in project inventory.</p></div><div class="btn-row"><a class="button button-light" asp-action="CreateTransfer">Transfer stock</a><a class="button button-light" asp-action="OpeningStock">Opening stock</a></div></div>
<div class="card"><div class="card-header"><h2>@(store?.Name ?? "Central store")</h2><span class="tag">@Model.Count items on this page</span></div><form method="get" class="filters"><div class="field"><label>Search material</label><input name="q" value="@q" placeholder="Item code or name" /></div><button class="button button-primary" type="submit">Search</button><a class="button button-light" asp-action="Company">Clear</a></form><div class="table-wrap"><table><thead><tr><th>Code</th><th>Material</th><th>Unit</th><th class="number">Total received</th><th class="number">Total issued</th><th class="number">Physical balance</th><th class="number">Available balance</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.ItemCode</td><td><strong>@x.ItemName</strong></td><td>@x.Unit</td><td class="number"><a class="count-link" asp-action="Matrix" asp-route-kind="received" asp-route-company="true" asp-route-itemId="@x.ItemId">@x.TotalReceived.ToString("0.####")</a></td><td class="number"><a class="count-link" asp-action="Matrix" asp-route-kind="issued" asp-route-company="true" asp-route-itemId="@x.ItemId">@x.TotalIssued.ToString("0.####")</a></td><td class="number"><a class="count-link" asp-action="Matrix" asp-route-kind="stock" asp-route-company="true" asp-route-itemId="@x.ItemId">@x.PhysicalBalance.ToString("0.####")</a></td><td class="number">@x.AvailableBalance.ToString("0.####")</td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="empty-state"><strong>No central stock transactions</strong>Post opening stock or transfer material into the central store.</div>}<div class="pagination"><span>Page @page of @pages · 100 items per page</span><div class="btn-row">@if(page>1){<a class="button button-light button-sm" asp-action="Company" asp-route-q="@q" asp-route-page="@(page-1)">Previous</a>}@if(page<pages){<a class="button button-light button-sm" asp-action="Company" asp-route-q="@q" asp-route-page="@(page+1)">Next</a>}</div></div></div>
