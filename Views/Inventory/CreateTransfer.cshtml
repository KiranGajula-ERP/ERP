@model StockTransferViewModel
@{ ViewData["Title"] = "Transfer stock"; var stores = ViewBag.Stores as List<StoreLocation> ?? []; var items = ViewBag.Items as List<Item> ?? []; }
<div class="section-head"><div><h1>Transfer stock</h1><p class="subheading">A transfer posts linked outward and inward ledger movements. Company stock and project stores are not double-counted.</p></div><a asp-action="Index" class="button button-light">Cancel</a></div><div class="card"><form asp-action="CreateTransfer" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label asp-for="Number">Transfer reference *</label><input asp-for="Number"/></div><div class="field"><label asp-for="ItemId">Material *</label><select asp-for="ItemId">@foreach(var i in items){<option value="@i.Id">@i.Code — @i.Name</option>}</select></div><div class="field"><label asp-for="SourceLocationId">From store *</label><select asp-for="SourceLocationId">@foreach(var s in stores){<option value="@s.Id">@(s.IsCentralStore?"Central: ":"")@s.Name</option>}</select></div><div class="field"><label asp-for="DestinationLocationId">To store *</label><select asp-for="DestinationLocationId">@foreach(var s in stores){<option value="@s.Id">@(s.IsCentralStore?"Central: ":"")@s.Name</option>}</select></div><div class="field"><label asp-for="Quantity">Transfer quantity *</label><input asp-for="Quantity" type="number" min="0.0001" step="0.0001"/></div><div class="field"><label asp-for="UnitCost">Unit cost (₹)</label><input asp-for="UnitCost" type="number" min="0" step="0.01"/></div></div><div class="form-actions"><button class="button button-primary" type="submit">Post transfer</button></div></form></div>
