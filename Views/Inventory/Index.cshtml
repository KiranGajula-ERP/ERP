@model List<StockBalance>
@{ ViewData["Title"] = "Project Inventory"; var projects = ViewBag.Projects as List<Project> ?? []; int? projectId = ViewBag.ProjectId as int?; var q = ViewBag.Query as string ?? ""; int page = (int)ViewBag.Page; int pages = (int)ViewBag.TotalPages; }
<div class="section-head"><div><h1>Project Inventory</h1><p class="subheading">Every role can view stock for its assigned projects. Click any quantity to open its filtered breakdown.</p></div><div class="btn-row">@if(User.IsInRole(AppRoles.SystemAdministrator)||User.IsInRole(AppRoles.Management)||User.IsInRole(AppRoles.PurchaseTeam)){<a class="button button-light" asp-action="OpeningStock">+ Opening stock</a><a class="button button-light" asp-action="CreateTransfer">⇄ Transfer stock</a>}@if(User.IsInRole(AppRoles.SystemAdministrator)||User.IsInRole(AppRoles.Management)||User.IsInRole(AppRoles.PurchaseTeam)||User.IsInRole(AppRoles.StoreInCharge)||User.IsInRole(AppRoles.SiteInCharge)){<a class="button button-light" asp-action="Adjustment" asp-route-projectId="@projectId">Stock adjustment / wastage</a>}@if(User.IsInRole(AppRoles.Worker)||User.IsInRole(AppRoles.Subcontractor)||User.IsInRole(AppRoles.SystemAdministrator)){<a class="button button-primary" asp-controller="Indents" asp-action="Create">+ Raise Indent</a>}</div></div>
@if ((bool)ViewBag.CanSeeTotals){<div class="tiles"><a class="tile blue" asp-action="Matrix" asp-route-kind="received" asp-route-projectId="@projectId"><span class="label">Total Received</span><span class="value">₹@(((decimal)ViewBag.TotalReceivedValue).ToString("N2"))</span><span class="hint">Accepted receipt value; open receipt records →</span></a><a class="tile saffron" asp-action="Matrix" asp-route-kind="issued" asp-route-projectId="@projectId"><span class="label">Total Issued</span><span class="value">₹@(((decimal)ViewBag.TotalIssuedValue).ToString("N2"))</span><span class="hint">Issued stock value; open issue records →</span></a><a class="tile green" asp-action="Matrix" asp-route-kind="stock" asp-route-projectId="@projectId"><span class="label">Balance Available Stock</span><span class="value">₹@(((decimal)ViewBag.AvailableStockValue).ToString("N2"))</span><span class="hint">Estimated available stock value; open stock details →</span></a><div class="tile"><span class="label">Material rows</span><span class="value">@Model.Count</span><span class="hint">Page @page of @pages · 100 items per page</span></div></div><div class="alert alert-info">Because stock uses different units (metres, numbers, kilograms, sets), adding the quantities together is not an accounting total. Use the per-material rows or exported register for meaningful totals.</div>}
<div class="card"><form method="get" class="filters"><div class="field"><label>Project</label><select name="projectId"><option value="">All assigned projects</option>@foreach(var p in projects){<option value="@p.Id" selected="@(projectId==p.Id)">@p.Name</option>}</select></div><div class="field"><label>Search material</label><input name="q" value="@q" placeholder="Item code or material name"/></div><button class="button button-primary" type="submit">Filter</button><a class="button button-light" asp-action="Index">Clear</a></form><div class="card-header"><h2>Stock by material</h2><span class="tag">@((ViewBag.SelectedProjects as List<string> ?? []).Count == 1 ? (ViewBag.SelectedProjects as List<string>)![0] : "Assigned projects")</span></div><div class="table-wrap"><table><thead><tr><th>Item code</th><th>Material</th><th>Unit</th><th class="number">Total Received</th><th class="number">Total Issued</th><th class="number">Physical Stock</th><th class="number">Reserved in Indents</th><th class="number">Available Stock</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.ItemCode</td><td><strong>@r.ItemName</strong></td><td>@r.Unit</td><td class="number"><a class="count-link" asp-action="Matrix" asp-route-kind="received" asp-route-projectId="@projectId" asp-route-itemId="@r.ItemId">@r.TotalReceived.ToString("0.####")</a></td><td class="number"><a class="count-link" asp-action="Matrix" asp-route-kind="issued" asp-route-projectId="@projectId" asp-route-itemId="@r.ItemId">@r.TotalIssued.ToString("0.####")</a></td><td class="number"><a class="count-link" asp-action="Matrix" asp-route-kind="stock" asp-route-projectId="@projectId" asp-route-itemId="@r.ItemId">@r.PhysicalBalance.ToString("0.####")</a></td><td class="number"><a class="count-link" asp-controller="Indents" asp-action="Index" asp-route-projectId="@projectId" asp-route-itemId="@r.ItemId">@r.Reserved.ToString("0.####")</a></td><td class="number"><a class="count-link" asp-action="Matrix" asp-route-kind="stock" asp-route-projectId="@projectId" asp-route-itemId="@r.ItemId">@r.AvailableBalance.ToString("0.####")</a></td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="empty-state"><strong>No material rows found</strong>Add items and post a GRN or opening stock, or check your project assignment.</div>}<div class="pagination"><span>Showing up to 100 items on page @page.</span><div class="btn-row">@if(page>1){<a class="button button-light button-sm" asp-action="Index" asp-route-projectId="@projectId" asp-route-q="@q" asp-route-page="@(page-1)">Previous</a>}@if(page<pages){<a class="button button-light button-sm" asp-action="Index" asp-route-projectId="@projectId" asp-route-q="@q" asp-route-page="@(page+1)">Next</a>}</div></div></div>
