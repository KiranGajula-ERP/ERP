@model StockOpeningViewModel
@{ ViewData["Title"] = "Opening stock"; var projects = ViewBag.Projects as List<Project> ?? []; var stores = ViewBag.Stores as List<StoreLocation> ?? []; var items = ViewBag.Items as List<Item> ?? []; }
<div class="section-head"><div><h1>Record opening stock</h1><p class="subheading">Use only during initial setup or an approved opening-balance adjustment. This posts a traceable ledger movement.</p></div><a asp-action="Index" class="button button-light">Cancel</a></div><div class="card"><form asp-action="OpeningStock" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label asp-for="ProjectId">Project for authorization *</label><select asp-for="ProjectId">@foreach(var p in projects){<option value="@p.Id">@p.Name</option>}</select></div><div class="field"><label asp-for="StoreLocationId">Store location *</label><select asp-for="StoreLocationId">@foreach(var s in stores){<option value="@s.Id">@(s.IsCentralStore?"Central: ":"")@s.Name</option>}</select></div><div class="field"><label asp-for="ItemId">Material *</label><select asp-for="ItemId">@foreach(var i in items){<option value="@i.Id">@i.Code — @i.Name</option>}</select></div><div class="field"><label asp-for="Quantity">Quantity *</label><input asp-for="Quantity" type="number" min="0.0001" step="0.0001"/><span asp-validation-for="Quantity" class="validation-message"></span></div><div class="field"><label asp-for="UnitCost">Unit cost (₹)</label><input asp-for="UnitCost" type="number" min="0" step="0.01"/></div><div class="field"><label asp-for="ReferenceNumber">Opening reference *</label><input asp-for="ReferenceNumber" placeholder="OPEN-001"/><span asp-validation-for="ReferenceNumber" class="validation-message"></span></div><div class="field wide"><label asp-for="Notes">Notes / approval reference</label><textarea asp-for="Notes"></textarea></div></div><div class="form-actions"><button class="button button-primary" type="submit">Post opening stock</button></div></form></div>
