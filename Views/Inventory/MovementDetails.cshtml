@model StockLedger
@using AuditFlow.Web.Models
@{ ViewData["Title"] = "Stock movement details"; var indent = ViewBag.RelatedIndent as MaterialIndent; var grn = ViewBag.RelatedGrn as GoodsReceiptNote; var transfer = ViewBag.RelatedTransfer as StockTransfer; var docs = ViewBag.LinkedDocuments as List<DocumentRecord> ?? []; }
<div class="section-head"><div><h1>Stock movement</h1><p class="subheading">@Model.ReferenceNumber · @Model.MovementType · @Model.PostedAtUtc.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</p></div><div class="btn-row"><a asp-controller="Inventory" asp-action="Matrix" asp-route-kind="stock" asp-route-projectId="@Model.ProjectId" class="button button-light">Back to stock movements</a><a asp-controller="Documents" asp-action="Create" asp-route-projectId="@Model.ProjectId" class="button button-primary">+ Link signed document</a></div></div>
<div class="tiles"><div class="tile blue"><span class="label">Material</span><span class="value">@Model.Item?.Name</span><span class="hint">@Model.Item?.Code · @Model.Item?.Unit?.Name</span></div><div class="tile saffron"><span class="label">Quantity change</span><span class="value">@Model.QuantityDelta.ToString("+0.####;-0.####;0")</span><span class="hint">@Model.MovementType</span></div><div class="tile"><span class="label">Unit cost</span><span class="value">₹@Model.UnitCost.ToString("N2")</span></div><div class="tile"><span class="label">Posted by</span><span class="value">@Model.PostedBy?.DisplayName</span></div></div>
<div class="card"><h2>Transaction details</h2><div class="detail-grid"><div class="detail-item"><small>Project</small><strong>@(Model.Project?.Name ?? "Central Company Store")</strong></div><div class="detail-item"><small>Store location</small><strong>@Model.StoreLocation?.Name</strong></div><div class="detail-item"><small>Source reference type</small><strong>@Model.ReferenceType</strong></div><div class="detail-item"><small>Reference number</small><strong>@Model.ReferenceNumber</strong></div><div class="detail-item"><small>Source record ID</small><strong>@(Model.ReferenceId?.ToString() ?? "—")</strong></div><div class="detail-item"><small>Posted at (UTC)</small><strong>@Model.PostedAtUtc.ToString("yyyy-MM-dd HH:mm")</strong></div><div class="detail-item"><small>Quantity</small><strong>@Math.Abs(Model.QuantityDelta).ToString("0.####") @Model.Item?.Unit?.Name</strong></div><div class="detail-item"><small>Value</small><strong>₹@((Math.Abs(Model.QuantityDelta) * Model.UnitCost).ToString("N2"))</strong></div></div><p><strong>Notes:</strong> @(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes recorded." : Model.Notes)</p></div>
@if(indent is not null){<div class="card"><div class="card-header"><h2>Related Indent</h2><a class="button button-primary button-sm" asp-controller="Indents" asp-action="Details" asp-route-id="@indent.Id">Open Indent @indent.Number →</a></div><div class="detail-grid"><div class="detail-item"><small>Requester</small><strong>@indent.RequestedBy?.DisplayName</strong></div><div class="detail-item"><small>Project</small><strong>@indent.Project?.Name</strong></div><div class="detail-item"><small>Tower</small><strong>@(indent.Tower?.Name ?? "General")</strong></div><div class="detail-item"><small>Status</small><strong>@indent.Status</strong></div><div class="detail-item"><small>Requested quantity</small><strong>@indent.RequestedQuantity.ToString("0.####") @indent.Item?.Unit?.Name</strong></div><div class="detail-item"><small>Issued to date</small><strong>@indent.IssuedQuantity.ToString("0.####") @indent.Item?.Unit?.Name</strong></div></div></div>}
@if(grn is not null){<div class="card"><div class="card-header"><h2>Related Goods Receipt Note</h2><a class="button button-primary button-sm" asp-controller="Procurement" asp-action="GoodsReceiptDetails" asp-route-id="@grn.Id">Open GRN @grn.Number →</a></div><p>The receipt is linked to this stock movement. Review its accepted quantities, supplier references and supporting documents on the GRN screen.</p></div>}
@if(transfer is not null){<div class="card"><div class="card-header"><h2>Related stock transfer</h2><a class="button button-primary button-sm" asp-action="TransferDetails" asp-route-id="@transfer.Id">Open transfer @transfer.Number →</a></div></div>}
<div class="card"><div class="card-header"><h2>Linked physical / signed documents</h2><a class="button button-light button-sm" asp-controller="Documents" asp-action="Create" asp-route-projectId="@Model.ProjectId">Add document reference</a></div><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Type</th><th>Title</th><th>File</th></tr></thead><tbody>@foreach(var d in docs){<tr><td>@d.ReferenceNumber</td><td>@d.DocumentType</td><td>@d.Title</td><td>@if(d.StoredPath is not null){<a class="button button-light button-sm" asp-controller="Documents" asp-action="Open" asp-route-id="@d.Id">Open attachment</a>}else{<span class="muted small">Reference only</span>}</td></tr>}</tbody></table></div>@if(!docs.Any()){<div class="empty-state"><strong>No attached document found</strong>Use “Link signed document” to attach a scanned copy or record an external physical reference.</div>}</div>
