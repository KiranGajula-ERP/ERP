@model StockAdjustmentViewModel
@{ ViewData["Title"]="Stock Adjustment / Wastage";var projects=ViewBag.Projects as List<Project>??[];var items=ViewBag.Items as List<Item>??[];var stores=ViewBag.Stores as List<StoreLocation>??[]; }
<div class="section-head"><div><h1>Stock Adjustment / Wastage</h1><p class="subheading">Use only for documented returns, wastage or authorized corrections. Every posting is immutable and auditable.</p></div><a class="button button-light" asp-action="Index" asp-route-projectId="@Model.ProjectId">Cancel</a></div><div class="card"><form asp-action="Adjustment" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label>Project *</label><select asp-for="ProjectId">@foreach(var p in projects){<option value="@p.Id">@p.Name</option>}</select></div><div class="field"><label>Store *</label><select asp-for="StoreLocationId">@foreach(var s in stores){<option value="@s.Id">@s.Name</option>}</select></div><div class="field wide"><label>Material *</label><select asp-for="ItemId">@foreach(var i in items){<option value="@i.Id">@i.Code — @i.Name</option>}</select></div><div class="field"><label>Movement type</label><select asp-for="AdjustmentType"><option value="Wastage">Wastage (reduce stock)</option><option value="AdjustmentOut">Adjustment out (reduce stock)</option><option value="AdjustmentIn">Adjustment in (increase stock)</option><option value="Return">Return to stock (increase stock)</option></select></div><div class="field"><label>Quantity *</label><input asp-for="Quantity" type="number" step="0.0001" min="0.0001"/></div><div class="field"><label>Unit cost (₹)</label><input asp-for="UnitCost" type="number" step="0.01" min="0"/></div><div class="field"><label>Reference *</label><input asp-for="ReferenceNumber"/></div><div class="field wide"><label>Reason / authorization reference *</label><textarea asp-for="Reason"></textarea></div></div><div class="form-actions"><button class="button button-primary" type="submit">Post stock movement</button></div></form></div>
