@model StockTransfer
@{ ViewData["Title"] = "Stock transfer details"; var moves = ViewBag.Movements as List<StockLedger> ?? []; var docs = ViewBag.LinkedDocuments as List<DocumentRecord> ?? []; }
<div class="section-head"><div><h1>Stock transfer @Model.Number</h1><p class="subheading">Source and destination stock movements recorded together under one reference.</p></div><a asp-action="Index" class="button button-light">Back to project inventory</a></div>
<div class="tiles"><div class="tile blue"><span class="label">Material</span><span class="value">@Model.Item?.Name</span><span class="hint">@Model.Item?.Code</span></div><div class="tile saffron"><span class="label">Transfer quantity</span><span class="value">@Model.Quantity.ToString("0.####") @Model.Item?.Unit?.Name</span></div><div class="tile"><span class="label">Status</span><span class="value">@Model.Status</span></div><div class="tile"><span class="label">Transfer date</span><span class="value">@Model.PostedAtUtc?.ToLocalTime().ToString("dd-MMM-yyyy")</span></div></div>
<div class="card"><h2>Movement legs</h2><div class="table-wrap"><table><thead><tr><th>Store</th><th>Project</th><th>Movement</th><th class="number">Quantity change</th><th>Posted by</th><th>Date</th></tr></thead><tbody>@foreach(var m in moves){<tr><td>@m.StoreLocation?.Name</td><td>@(m.Project?.Name ?? "Central Store")</td><td>@m.MovementType</td><td class="number">@m.QuantityDelta.ToString("+0.####;-0.####;0")</td><td>@m.PostedBy?.DisplayName</td><td>@m.PostedAtUtc.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</td></tr>}</tbody></table></div></div>
<div class="card"><div class="card-header"><h2>Supporting documents</h2><a class="button button-light button-sm" asp-controller="Documents" asp-action="Create" asp-route-projectId="@Model.SourceLocation?.ProjectId">+ Link document</a></div><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Type</th><th>Title</th><th>File</th></tr></thead><tbody>@foreach(var d in docs){<tr><td>@d.ReferenceNumber</td><td>@d.DocumentType</td><td>@d.Title</td><td>@if(d.StoredPath is not null){<a asp-controller="Documents" asp-action="Open" asp-route-id="@d.Id" class="button button-light button-sm">Open attachment</a>}else{<span class="muted small">Reference only</span>}</td></tr>}</tbody></table></div>@if(!docs.Any()){<div class="empty-state">No supporting files linked.</div>}</div>
