@model CreateProjectExpenseViewModel
@{ViewData["Title"]="Record Project Expense";var projects=ViewBag.Projects as List<Project>??[];}
<div class="section-head"><div><h1>Record Project Expense</h1><p class="subheading">Expense entries feed project cost reporting; attach receipts in the Document Register after saving.</p></div><a class="button button-light" asp-action="Index" asp-route-projectId="@Model.ProjectId">Cancel</a></div><div class="card"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label>Project *</label><select asp-for="ProjectId">@foreach(var p in projects){<option value="@p.Id">@p.Name</option>}</select></div><div class="field"><label>Date</label><input asp-for="ExpenseDate" type="date"/></div><div class="field"><label>Category *</label><select asp-for="Category">@foreach(var c in new[]{"Overhead","Transportation","Tools","Accommodation","Power / Water","Housekeeping","Safety","Other"}){<option value="@c">@c</option>}</select></div><div class="field"><label>Amount (₹) *</label><input asp-for="Amount" type="number" min="0.01" step="0.01"/><span asp-validation-for="Amount" class="validation-message"></span></div><div class="field wide"><label>Description *</label><input asp-for="Description"/><span asp-validation-for="Description" class="validation-message"></span></div><div class="field wide"><label>Receipt / voucher reference</label><input asp-for="Reference"/></div></div><div class="form-actions"><button class="button button-primary">Save expense</button></div></form></div>
