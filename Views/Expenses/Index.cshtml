@model List<ProjectExpense>
@{ViewData["Title"]="Project Expenses";var projects=ViewBag.Projects as List<Project>??[];int? projectId=ViewBag.ProjectId as int?;string category=ViewBag.Category as string??"";}
<div class="section-head"><div><h1>Project Expenses & Overheads</h1><p class="subheading">Record site overheads, transport, accommodation, utilities and other project costs.</p></div><a class="button button-primary" asp-action="Create" asp-route-projectId="@projectId">+ Record expense</a></div><div class="tiles"><div class="tile saffron"><span class="label">Total expenses in filter</span><span class="value">₹@(((decimal)ViewBag.Total).ToString("N2"))</span></div><div class="tile"><span class="label">Records shown</span><span class="value">@Model.Count</span></div></div><div class="card"><form method="get" class="filters"><div class="field"><label>Project</label><select name="projectId"><option value="">All assigned projects</option>@foreach(var p in projects){<option value="@p.Id" selected="@(projectId==p.Id)">@p.Name</option>}</select></div><div class="field"><label>Category</label><select name="category"><option value="">All</option>@foreach(var c in new[]{"Overhead","Transportation","Tools","Accommodation","Power / Water","Housekeeping","Safety","Other"}){<option selected="@(category==c)" value="@c">@c</option>}</select></div><button class="button button-primary">Apply</button><a class="button button-light" asp-action="Index">Clear</a></form><div class="table-wrap"><table><thead><tr><th>Date</th><th>Project</th><th>Category</th><th>Description</th><th>Reference</th><th class="number">Amount</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.ExpenseDate.ToString("dd-MMM-yyyy")</td><td>@x.Project?.Name</td><td>@x.Category</td><td>@x.Description</td><td>@x.Reference</td><td class="number">₹@x.Amount.ToString("N2")</td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="empty-state">No expenses have been recorded for this filter.</div>}</div>
