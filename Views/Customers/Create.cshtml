@model CreateCustomerViewModel
@{ ViewData["Title"] = "Add customer"; }
<div class="section-head"><div><h1>Add customer / client</h1><p class="subheading">Keep the legal billing identity consistent with the contract.</p></div><a asp-action="Index" class="button button-light">Cancel</a></div><div class="card"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label>Name *</label><input asp-for="Name"/></div><div class="field"><label>Code</label><input asp-for="Code"/></div><div class="field"><label>GSTIN</label><input asp-for="GSTIN"/></div><div class="field"><label>Contact email</label><input asp-for="ContactEmail"/></div><div class="field"><label>Contact phone</label><input asp-for="ContactPhone"/></div><div class="field wide"><label>Billing address</label><textarea asp-for="BillingAddress"></textarea></div></div><div class="form-actions"><button class="button button-primary" type="submit">Save customer</button></div></form></div>
