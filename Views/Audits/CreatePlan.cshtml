@model AuditFlow.Web.Models.CreateAuditPlanViewModel
@using AuditFlow.Web.Models
@{ ViewData["Title"] = "Schedule audit"; var projects = ViewBag.Projects as List<Project> ?? []; var owners = ViewBag.Owners as List<AppUser> ?? []; }
<div class="section-head"><div><h1>Schedule audit</h1><p class="subheading">Plan a project audit and assign an owner.</p></div><a asp-action="Index" class="button button-light">Back to audits</a></div>
<div class="card form-card"><form asp-action="CreatePlan" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="field"><label asp-for="ProjectId">Project</label><select asp-for="ProjectId">@foreach(var p in projects){<option value="@p.Id">@p.Code — @p.Name</option>}</select><span asp-validation-for="ProjectId" class="validation"></span></div><div class="field"><label asp-for="Title">Audit title</label><input asp-for="Title" placeholder="e.g. Material and safety audit"/><span asp-validation-for="Title" class="validation"></span></div><div class="field"><label asp-for="PlannedDate">Planned date</label><input asp-for="PlannedDate" type="date"/><span asp-validation-for="PlannedDate" class="validation"></span></div><div class="field"><label asp-for="OwnerId">Owner (optional)</label><select asp-for="OwnerId"><option value="">Unassigned</option>@foreach(var u in owners){<option value="@u.Id">@u.DisplayName (@AppRoles.Label(u.Role))</option>}</select></div></div><div class="btn-row"><button class="button button-primary" type="submit">Schedule audit</button><a asp-action="Index" class="button button-light">Cancel</a></div></form></div>
