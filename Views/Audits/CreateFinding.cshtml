@model CreateFindingViewModel
@{ ViewData["Title"] = "Create finding"; var projects = ViewBag.Projects as List<Project> ?? []; }
<div class="section-head"><div><h1>Create finding</h1><p class="subheading">Record an issue, owner follow-up and potential exposure.</p></div><a asp-action="Index" class="button button-light">Cancel</a></div><div class="card"><form asp-action="CreateFinding" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label>Project *</label><select asp-for="ProjectId">@foreach(var p in projects){<option value="@p.Id">@p.Name</option>}</select></div><div class="field"><label>Severity</label><select asp-for="Severity"><option>Low</option><option>Medium</option><option>High</option><option>Critical</option></select></div><div class="field wide"><label>Title *</label><input asp-for="Title"/></div><div class="field wide"><label>Description</label><textarea asp-for="Description"></textarea></div><div class="field"><label>Potential exposure (₹)</label><input asp-for="ExposureAmount" type="number" min="0" step="0.01"/></div><div class="field"><label>Due date</label><input asp-for="DueDate" type="date"/></div></div><div class="form-actions"><button class="button button-primary" type="submit">Create finding</button></div></form></div>
