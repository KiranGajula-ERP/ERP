@model List<Finding>
@using AuditFlow.Web.Models
@{ ViewData["Title"] = "Audit & Findings"; var projects = ViewBag.Projects as List<Project> ?? []; var audits = ViewBag.Audits as List<AuditPlan> ?? []; int? projectId = ViewBag.ProjectId as int?; }
<div class="section-head"><div><h1>Audit Management & Findings</h1><p class="subheading">Scheduled audits, open findings, exposure and corrective actions.</p></div><div class="btn-row">@if(User.IsInRole(AppRoles.SystemAdministrator)||User.IsInRole(AppRoles.Management)||User.IsInRole(AppRoles.SiteInCharge)){<a asp-action="CreatePlan" asp-route-projectId="@projectId" class="button button-light">+ Schedule audit</a>}<a asp-action="CreateFinding" asp-route-projectId="@projectId" class="button button-primary">+ Create finding</a></div></div><div class="card"><form method="get" class="filters"><div class="field"><label>Project</label><select name="projectId"><option value="">All assigned projects</option>@foreach(var p in projects){<option value="@p.Id" selected="@(projectId==p.Id)">@p.Name</option>}</select></div><button type="submit" class="button button-primary">Filter</button><a class="button button-light" asp-action="Index">Clear</a></form><div class="card-header"><h2>Scheduled audits</h2></div><div class="table-wrap"><table><thead><tr><th>Audit</th><th>Project</th><th>Planned</th><th>Status</th><th>Owner</th></tr></thead><tbody>@foreach(var a in audits){<tr><td>@a.Title</td><td>@a.Project?.Name</td><td>@a.PlannedDate?.ToString("dd-MMM-yyyy")</td><td><span class="tag">@a.Status</span></td><td>@a.Owner?.DisplayName</td></tr>}</tbody></table></div><h2 style="margin-top:24px">Findings & actions</h2><div class="table-wrap"><table><thead><tr><th>Finding</th><th>Project</th><th>Severity</th><th>Owner</th><th>Due date</th><th class="number">Exposure</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var f in Model){<tr><td><strong>@f.Number</strong><div>@f.Title</div><div class="muted small">@f.Description</div></td><td>@f.Project?.Name</td><td><span class="tag @(f.Severity=="Critical"||f.Severity=="High"?"tag-red":"tag-yellow")">@f.Severity</span></td><td>@f.AssignedTo?.DisplayName</td><td>@f.DueDate?.ToString("dd-MMM-yyyy")</td><td class="number">₹@f.ExposureAmount.ToString("N2")</td><td><span class="tag">@f.Status</span></td><td>@if(f.Status!="Closed"){<form asp-action="CloseFinding" method="post"><input type="hidden" name="id" value="@f.Id"/><button class="button button-light button-sm" data-confirm="Close this finding?">Close</button></form>}</td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="empty-state"><strong>No findings</strong>Create an issue from an audit or site observation.</div>}</div>
